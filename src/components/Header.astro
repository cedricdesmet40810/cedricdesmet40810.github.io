---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SERVICES, SITE } from '../config.js';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
const bookHref = SITE.bookingUrl || '/contact/';
---

<header class="site-header" data-header>
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label="Auxilia, naar de homepagina"><Logo /></a>
    <nav class="header__nav" aria-label="Hoofdnavigatie">
      <ul class="nav-list">
        {NAV.map(item => item.href === '/oplossingen/' ? (
          <li>
            <details class="nav-disclosure" data-nav-disclosure>
              <summary class:list={['nav-link', isActive(item.href) && 'is-active']}>
                {item.label}
                <svg class="nav-caret" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </summary>
              <div class="submenu">
                <a href="/oplossingen/" class="submenu__all">Alle oplossingen <span aria-hidden="true">↗</span></a>
                <ul>{SERVICES.map(s => (
                  <li><a href={`/oplossingen/${s.slug}/`} aria-current={path === `/oplossingen/${s.slug}/` ? 'page' : undefined}>
                    <span class="submenu__icon"><Icon name={s.icon} size={20} /></span>
                    <span><strong>{s.nav}</strong><span class="submenu__excerpt">{s.excerpt}</span></span>
                  </a></li>
                ))}</ul>
              </div>
            </details>
          </li>
        ) : (
          <li><a href={item.href} class:list={['nav-link', isActive(item.href) && 'is-active']} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header__actions"><a href={bookHref} class="btn btn--primary btn--sm">Plan 30 minuten <span class="arrow" aria-hidden="true">↗</span></a></div>
    <button type="button" class="header__toggle" data-menu-toggle aria-expanded="false" aria-controls="mobiel-menu" aria-label="Menu openen" hidden><span></span><span></span></button>
  </div>
</header>
<div class="mobile-menu" id="mobiel-menu" data-menu hidden>
  <nav class="container" aria-label="Mobiele navigatie">
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/oplossingen/">Oplossingen</a></li>
      {SERVICES.map(s => <li class="mobile-menu__service"><a href={`/oplossingen/${s.slug}/`}>{s.nav}</a></li>)}
      <li><a href="/ons-werk/">Ons werk</a></li>
      <li><a href="/over-ons/">Over ons</a></li>
      <li><a href="/contact/">Contact</a></li>
    </ul>
    <a href={bookHref} class="btn btn--primary">Plan 30 minuten <span aria-hidden="true">↗</span></a>
  </nav>
</div>
<noscript><nav class="no-script-nav container" aria-label="Navigatie">{NAV.map(item => <a href={item.href}>{item.label}</a>)}</nav></noscript>

<style>
  .site-header { position: sticky; top: 0; z-index: 60; background: rgb(231 239 231 / 96%); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid transparent; }
  .site-header.is-stuck { border-bottom-color: var(--line-soft); }
  .header__inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; height: 96px; }
  .header__logo { text-decoration: none; flex: none; }
  .nav-list { display: flex; align-items: center; gap: 24px; list-style: none; margin: 0; padding: 0; }
  .nav-link { display: inline-flex; align-items: center; gap: 8px; padding: 12px 4px; color: var(--ink-soft); font-size: .94rem; font-weight: 500; text-decoration: none; white-space: nowrap; cursor: pointer; list-style: none; }
  .nav-link:hover, .nav-link.is-active, .nav-disclosure[open] .nav-link { color: var(--teal); }
  a.nav-link[aria-current] { text-decoration: underline; text-decoration-color: var(--brand-orange); text-underline-offset: 9px; }
  summary::-webkit-details-marker { display: none; }
  .nav-disclosure { position: relative; }
  .nav-caret { transition: transform .2s var(--ease); }
  .nav-disclosure[open] .nav-caret { transform: rotate(180deg); }
  .submenu { position: absolute; top: calc(100% + 14px); left: -28px; width: 408px; max-height: calc(100dvh - 120px); overflow-y: auto; overscroll-behavior: contain; background: var(--paper); border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--shadow-lg); padding: 12px; }
  .submenu ul { list-style: none; margin: 0; padding: 0; }
  .submenu a { display: grid; grid-template-columns: 38px 1fr; gap: 12px; align-items: start; padding: 12px; border-radius: 10px; text-decoration: none; color: inherit; }
  .submenu a:hover { background: var(--sand); }
  .submenu .submenu__all { display: flex; justify-content: space-between; font-weight: 600; margin-bottom: 6px; border-bottom: 1px solid var(--line-soft); border-radius: 0; padding-bottom: 16px; }
  .submenu__icon { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 10px; background: var(--sand-deep); color: var(--teal); }
  .submenu strong { display: block; font-size: .94rem; font-weight: 600; margin-bottom: 3px; }
  .submenu__excerpt { display: block; font-size: .82rem; line-height: 1.45; color: var(--ink-soft); }
  .header__actions { flex: none; }
  .btn--sm { padding: 14px 22px; min-height: 48px; font-size: .9rem; }
  .header__toggle { display: none; flex: none; width: 46px; height: 46px; padding: 0; background: transparent; border: 1px solid var(--line); border-radius: 50%; cursor: pointer; align-items: center; justify-content: center; flex-direction: column; gap: 6px; }
  .header__toggle span { width: 18px; height: 1.5px; background: var(--ink); transition: transform .2s var(--ease); }
  .header__toggle[aria-expanded='true'] span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .header__toggle[aria-expanded='true'] span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  .mobile-menu { position: fixed; inset: 76px 0 0; z-index: 55; background: var(--hero-sage); overflow-y: auto; overscroll-behavior: contain; padding: 16px 0 40px; }
  .mobile-menu ul { list-style: none; margin: 0 0 24px; padding: 0; }
  .mobile-menu li { border-bottom: 1px solid var(--line); }
  .mobile-menu a:not(.btn) { display: block; padding: 12px 0; font-size: 1.2rem; font-weight: 550; color: var(--ink); text-decoration: none; }
  .mobile-menu .mobile-menu__service a { font-size: .98rem; font-weight: 400; padding-left: 18px; }
  .mobile-menu .btn { width: 100%; }
  .no-script-nav { display: none; }
  @media (max-width: 1080px) {
    .header__inner { height: 76px; }
    .header__nav, .header__actions { display: none; }
    .header__toggle { display: flex; }
    .no-script-nav { display: flex; flex-wrap: wrap; gap: 8px 20px; padding-block: 14px; }
  }
  @media (min-width: 1081px) { .mobile-menu { display: none; } }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  const disclosure = document.querySelector<HTMLDetailsElement>('[data-nav-disclosure]');
  if (toggle && menu) {
    toggle.hidden = false;
    const background = [...document.querySelectorAll<HTMLElement>('main, .site-footer')];
    const setOpen = (open: boolean, restoreFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Menu sluiten' : 'Menu openen');
      menu.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
      background.forEach(el => { el.inert = open; });
      if (restoreFocus) toggle.focus();
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', event => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    window.matchMedia('(min-width: 1081px)').addEventListener('change', event => {
      if (event.matches) setOpen(false);
    });
    document.addEventListener('keydown', event => {
      if (menu.hidden) return;
      if (event.key === 'Escape') { setOpen(false, true); return; }
      if (event.key !== 'Tab') return;
      const links = [...menu.querySelectorAll<HTMLAnchorElement>('a[href]')];
      const first = toggle;
      const last = links[links.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    });
  }
  if (disclosure) {
    document.addEventListener('click', event => {
      if (event.target instanceof Node && !disclosure.contains(event.target)) disclosure.open = false;
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && disclosure.open) {
        disclosure.open = false;
        disclosure.querySelector('summary')?.focus();
      }
    });
    disclosure.addEventListener('focusout', event => {
      if (event.relatedTarget instanceof Node && !disclosure.contains(event.relatedTarget)) disclosure.open = false;
    });
  }
  if (header) {
    const onScroll = () => header.classList.toggle('is-stuck', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
