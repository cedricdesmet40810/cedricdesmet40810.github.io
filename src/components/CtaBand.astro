---
import { SITE } from '../config.js';
import SiteImage from './SiteImage.astro';
const { eyebrow = 'Klaar om te beginnen', title = 'Na dertig minuten weet je het', text = 'Eén gesprek, online of bij jou op kantoor. Je hoort waar AI bij jullie het snelst rendeert, en wat je beter eerst zelf probeert.', primary = 'Plan 30 minuten', secondary = { label: 'Bekijk de oplossingen', href: '/oplossingen/' } } = Astro.props;
---
<section class="cta-section">
  <div class="container">
    <div class="cta-band band-teal">
      <div class="cta-band__inner">
        <p class="eyebrow">{eyebrow}</p>
        <h2 class="statement">{title}</h2>
        <p class="lead">{text}</p>
        <div class="btn-row cta-band__actions">
          <a href={SITE.bookingUrl || '/contact/'} class="btn btn--primary">{primary}<span class="arrow" aria-hidden="true">↗</span></a>
          {secondary && <a href={secondary.href} class="btn btn--secondary">{secondary.label}</a>}
        </div>
        <p class="cta-band__note">Vrijblijvend · online of bij je op kantoor</p>
      </div>
      <SiteImage class="cta-band__mascot" src="/hero-contact-clean.png" alt="" width="1000" loading="lazy" sizes="(max-width: 900px) 1px, 30vw" />
    </div>
  </div>
</section>
<style>
  .cta-section { padding-block: 24px 96px; background: var(--sand); }
  .cta-band { display: grid; grid-template-columns: 1.3fr .7fr; align-items: center; gap: 32px; padding: clamp(32px, 5vw, 64px); border-radius: 28px; overflow: hidden; }
  .cta-band .statement { font-size: clamp(2.2rem, 4vw, 3.6rem); max-width: 19ch; }
  .cta-band .lead { margin-top: 24px; max-width: 50ch; font-size: 1.05rem; }
  .cta-band__actions { margin-top: 32px; }
  .cta-band__note { margin-top: 24px; font-size: .86rem; color: #c6d9d1; }
  .cta-band__mascot { width: 100%; height: auto; max-height: 400px; object-fit: contain; }
  @media (max-width: 900px) { .cta-band { grid-template-columns: 1fr; } .cta-band__mascot { display: none; } }
  @media (max-width: 600px) { .cta-section { padding-block: 16px 64px; } .cta-band { padding: 34px 26px; border-radius: 20px; } }
</style>
