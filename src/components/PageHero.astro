---
import { SITE } from '../config.js';
import SiteImage from './SiteImage.astro';
interface Props {
  title: string;
  lead?: string;
  badge?: string;
  crumbs?: { name: string; href: string }[];
  cta?: boolean;
  ctaLabel?: string;
  secondary?: { label: string; href: string } | null;
  size?: string;
  beeld?: string;
  beeldAlt?: string;
  beeldVrij?: boolean;
}
const { badge, title, lead, crumbs = [], cta = false, ctaLabel = 'Plan 30 minuten', secondary = null, size = 'default', beeld, beeldAlt = '', beeldVrij = false } = Astro.props;
---
<section class:list={['phero', size === 'compact' && 'phero--compact', beeld && 'phero--beeld']}>
  <div class="container phero__inner">
    <div class="phero__tekst">
      {crumbs.length > 0 && <nav class="phero__crumbs" aria-label="Kruimelpad"><ol><li><a href="/">Home</a></li>{crumbs.map((c, i) => <li aria-current={i === crumbs.length - 1 ? 'page' : undefined}>{i === crumbs.length - 1 ? c.name : <a href={c.href}>{c.name}</a>}</li>)}</ol></nav>}
      {badge && <p class="hero-badge">{badge}</p>}
      <h1>{title}</h1>
      {lead && <p class="phero__lead">{lead}</p>}
      {(cta || secondary) && <div class="btn-row phero__actions">
        {cta && <a href={SITE.bookingUrl || '/contact/'} class="btn btn--primary">{ctaLabel}<span class="arrow" aria-hidden="true">↗</span></a>}
        {secondary && <a href={secondary.href} class="btn btn--secondary">{secondary.label}</a>}
      </div>}
    </div>
    {beeld && <div class:list={['phero__visual', beeldVrij && 'phero__visual--free']}><SiteImage class="phero__beeld" src={beeld} width="1000" fetchpriority="high" loading="eager" decoding="async" alt={beeldAlt} sizes="(max-width: 899px) 80vw, 40vw" /></div>}
  </div>
</section>

<style>
  .phero { padding: 48px 0 96px; background: var(--hero-sage); }
  .phero__inner { display: grid; gap: 48px; align-items: center; }
  .phero__tekst { padding: 10px 0; }
  .phero h1 { max-width: 18ch; font-size: clamp(2.8rem, 5.8vw, 5.2rem); line-height: 1.08; letter-spacing: -.05em; font-weight: 560; }
  .phero__lead { color: var(--ink-soft); margin: 26px 0 0; max-width: 52ch; font-size: 1.15rem; line-height: 1.7; }
  .phero__actions { margin-top: 32px; }
  .phero__crumbs ol { display: flex; flex-wrap: wrap; gap: 9px; list-style: none; padding: 0; margin: 0 0 32px; font-size: .84rem; color: var(--ink-faint); }
  .phero__crumbs li + li::before { content: '/'; margin-right: 9px; opacity: .6; }
  .phero__crumbs a { color: var(--ink-soft); text-decoration: none; }
  .phero__crumbs a:hover { color: var(--clay); }
  .hero-badge { margin: 0 0 28px; }
  .phero__visual { background: #f5eee5; border-radius: 100px 20px 20px 20px; overflow: hidden; display: grid; place-items: center; min-width: 0; height: 500px; padding: 14px; }
  .phero__beeld { width: 100%; height: 100%; max-height: 472px; object-fit: contain; mix-blend-mode: multiply; }
  .phero__visual--free { background: transparent; border-radius: 0; padding: 24px; }
  .phero__visual--free .phero__beeld { mix-blend-mode: normal; }
  .phero--compact { padding-bottom: 72px; }
  .phero--compact h1 { font-size: clamp(2.8rem, 5.4vw, 4.6rem); }
  @media (min-width: 900px) {
    .phero--beeld .phero__inner { grid-template-columns: 1.1fr .9fr; gap: 72px; }
    .phero--beeld h1 { font-size: clamp(2.8rem, 4.8vw, 4.5rem); }
  }
  @media (max-width: 1100px) and (min-width: 900px) {
    .phero--beeld .phero__inner { gap: 40px; }
    .phero__visual { height: 430px; }
    .phero__beeld { max-height: 400px; }
  }
  @media (max-width: 899px) {
    .phero { padding: 24px 0 64px; }
    .phero__visual { height: 380px; max-width: 520px; width: 100%; }
    .phero__beeld { max-height: 350px; }
    .phero__lead { font-size: 1.08rem; }
    .phero h1 { max-width: 17ch; }
  }
  @media (max-width: 600px) {
    .phero h1 { font-size: clamp(2.55rem, 9vw, 3.5rem); }
    .phero__crumbs ol { font-size: .78rem; margin-bottom: 28px; }
    .phero__inner { gap: 32px; }
    .phero__visual { height: 340px; border-radius: 70px 16px 16px 16px; }
    .phero__beeld { max-height: 310px; }
  }
</style>
