---
/**
 * De donkere paginakop die elke pagina hetzelfde filmische ritme geeft:
 * badge, één grote zin, een korte lead en de Kempen-horizon onderaan.
 */
import { SITE } from '../config.js';

const {
  badge,
  title,
  lead,
  /** [{ name, href }] — subtiel kruimelpad boven de badge. */
  crumbs = [],
  /** Toon de primaire knop. */
  cta = false,
  ctaLabel = 'Plan 30 minuten',
  secondary = null,
  /** 'compact' voor tekstpagina's zoals privacy. */
  size = 'default',
  /** 3D-render rechts naast de tekst. Zonder beeld blijft de tekst volle breedte. */
  beeld,
  beeldAlt = '',
} = Astro.props;
---

<section
  class:list={[
    'phero band-teal',
    size === 'compact' && 'phero--compact',
    beeld && 'phero--beeld',
  ]}
>
  <div class="container phero__inner">
    <div class="phero__tekst">
    {
      crumbs.length > 0 && (
        <nav class="phero__crumbs" aria-label="Kruimelpad">
          <ol>
            <li>
              <a href="/">Home</a>
            </li>
            {crumbs.map((c, i) => (
              <li aria-current={i === crumbs.length - 1 ? 'page' : undefined}>
                {i === crumbs.length - 1 ? c.name : <a href={c.href}>{c.name}</a>}
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    {badge && <p class="hero-badge">{badge}</p>}

    <h1>{title}</h1>
    {lead && <p class="phero__lead">{lead}</p>}

    {
      (cta || secondary) && (
        <div class="btn-row phero__actions">
          {cta && (
            <a href={SITE.bookingUrl || '/contact/'} class="btn btn--primary">
              {ctaLabel}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          )}
          {secondary && (
            <a href={secondary.href} class="btn btn--secondary">
              {secondary.label}
            </a>
          )}
        </div>
      )
    }
    </div>

    {
      beeld && (
        <img
          class="phero__beeld"
          src={beeld}
          width="1000"
          height="1340"
          fetchpriority="high"
          decoding="async"
          alt={beeldAlt}
        />
      )
    }
  </div>

  <svg
    class="phero__horizon"
    viewBox="0 0 1440 150"
    preserveAspectRatio="xMidYMax slice"
    aria-hidden="true"
  >
    <circle cx="1150" cy="96" r="36" fill="#D2691E" opacity="0.8" />
    <g
      fill="none"
      stroke="rgba(250,247,242,0.3)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M-10 128 Q 260 112 560 124 T 1100 120 T 1450 128" />
      <path d="M200 122 l14 -30 l14 30 m-21 -16 l7 -16 l7 16" />
      <path d="M244 124 l10 -22 l10 22 m-15 -12 l5 -12 l5 12" />
      <path d="M890 122 l15 -33 l15 33 m-22 -17 l7 -17 l7 17" />
      <path d="M934 124 l11 -23 l11 23 m-16 -12 l5 -12 l5 12" />
    </g>
    <path
      d="M-10 150 L-10 132 Q 320 116 740 128 T 1450 132 L1450 150 Z"
      fill="rgba(11,69,67,0.55)"
    />
  </svg>
</section>

<style>
  /* Zelfde ritme als de hero op de homepage: de donkere header loopt visueel
     door in de band, en de tekst lijnt links uit. */
  .phero {
    position: relative;
    overflow: hidden;
    margin-top: -78px;
    padding-top: calc(78px + clamp(3.5rem, 6vw, 6rem));
    padding-bottom: clamp(6rem, 9vw, 8rem);
    background:
      radial-gradient(80rem 36rem at 20% -16rem, rgba(62, 132, 130, 0.5), transparent 60%),
      var(--teal);
  }

  .phero--compact {
    padding-top: calc(78px + clamp(2.75rem, 4.5vw, 4.25rem));
    padding-bottom: clamp(5rem, 7vw, 6.5rem);
  }

  .phero__inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
  }

  /* Met beeld: tekst links, render rechts. Het beeld staat hoger in de
     bronvolgorde dan de horizon, dus het blijft er netjes voor. */
  @media (min-width: 900px) {
    .phero--beeld .phero__inner {
      display: grid;
      grid-template-columns: 1fr 0.78fr;
      gap: clamp(32px, 5vw, 64px);
      align-items: center;
    }
  }

  .phero__beeld {
    display: block;
    width: 100%;
    max-width: 380px;
    height: auto;
    margin: 40px auto 0;
    border-radius: var(--r-lg);
  }

  @media (min-width: 900px) {
    .phero__beeld {
      max-width: none;
      margin: 0;
    }
  }

  .phero__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    font-size: 0.85rem;
    color: rgba(250, 247, 242, 0.75);
  }

  .phero__crumbs li + li::before {
    content: '/';
    margin-right: 8px;
    opacity: 0.6;
  }

  .phero__crumbs a {
    color: rgba(250, 247, 242, 0.75);
    text-decoration: none;
  }

  .phero__crumbs a:hover {
    color: var(--sand);
  }

  .hero-badge {
    margin: 0 0 28px;
  }

  .phero h1 {
    font-size: clamp(2.6rem, 5.4vw, 4.4rem);
    max-width: 19ch;
  }

  /* De tekstkolom is smaller zodra er een render naast staat. */
  .phero--beeld h1 {
    max-width: 14ch;
  }

  .phero--beeld .phero__lead {
    max-width: 44ch;
  }

  .phero__lead {
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    line-height: 1.55;
    color: rgba(250, 247, 242, 0.8);
    max-width: 50ch;
    margin: 24px 0 0;
  }

  .phero__actions {
    margin-top: 36px;
  }

  .phero__horizon {
    position: absolute;
    inset: auto 0 0;
    width: 100%;
    height: clamp(80px, 10vw, 150px);
    display: block;
  }
</style>
