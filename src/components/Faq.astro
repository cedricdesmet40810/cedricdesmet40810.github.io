---
/**
 * Gebouwd op <details>: werkt zonder JavaScript en is meteen
 * toegankelijk met het toetsenbord.
 * De bijhorende FAQPage-schema zet de pagina zelf, uit dezelfde array.
 */
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq__item">
        <summary>
          <span>{item.q}</span>
          <svg class="faq__sign" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14" />
            <path class="faq__bar" d="M12 5v14" />
          </svg>
        </summary>
        <div class="faq__answer">
          <p set:html={item.a} />
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 12px;
    max-width: 820px;
  }

  .faq__item {
    background: var(--paper);
    border: 1px solid var(--line-soft);
    border-radius: var(--r);
    box-shadow: var(--shadow);
    transition: border-color 0.25s var(--ease);
  }

  .faq__item[open] {
    border-color: rgba(15, 92, 90, 0.22);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 24px;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.16rem;
    font-weight: 500;
    letter-spacing: -0.018em;
    line-height: 1.3;
    color: var(--ink);
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq__sign {
    width: 22px;
    height: 22px;
    flex: none;
    fill: none;
    stroke: var(--teal);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .faq__bar {
    transform-origin: center;
    transition: transform 0.25s var(--ease), opacity 0.25s var(--ease);
  }

  .faq__item[open] .faq__bar {
    transform: rotate(90deg);
    opacity: 0;
  }

  .faq__answer {
    padding: 0 24px 24px;
  }

  .faq__answer p {
    margin: 0;
    color: var(--ink-soft);
    max-width: 68ch;
  }
</style>
