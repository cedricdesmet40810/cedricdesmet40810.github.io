---
/**
 * Gebouwd op <details>: werkt zonder JavaScript en is meteen
 * toegankelijk met het toetsenbord.
 * De bijhorende FAQPage-schema zet de pagina zelf, uit dezelfde array.
 */
interface Props { items: { q: string; a: string }[]; }
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq__item">
        <summary>
          <span>{item.q}</span>
          <svg class="faq__sign" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14" />
            <path class="faq__bar" d="M12 5v14" />
          </svg>
        </summary>
        <div class="faq__answer">
          <p set:html={item.a} />
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq { width: 100%; max-width: 900px; }
  .faq__item { border-top: 1px solid var(--line); background: transparent; }
  .faq__item:last-child { border-bottom: 1px solid var(--line); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 22px; padding: 26px 0; cursor: pointer; font-size: 1.1rem; font-weight: 550; letter-spacing: -.015em; line-height: 1.4; color: var(--ink); list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .faq__sign { width: 30px; height: 30px; padding: 5px; flex: none; border-radius: 50%; background: var(--paper); fill: none; stroke: var(--teal); stroke-width: 1.6; stroke-linecap: round; }
  .faq__bar { transform-origin: center; transition: transform .2s var(--ease), opacity .2s var(--ease); }
  .faq__item[open] .faq__bar { transform: rotate(90deg); opacity: 0; }
  .faq__item[open] .faq__sign { background: var(--sand-deep); }
  .faq__answer { padding: 0 46px 28px 0; }
  .faq__answer p { margin: 0; color: var(--ink-soft); max-width: 66ch; font-size: 1rem; }
  @media (max-width: 600px) { summary { font-size: 1.03rem; padding-block: 22px; } .faq__answer { padding-right: 0; } }
</style>
