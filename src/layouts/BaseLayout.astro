---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config.js';

// Zelf gehoste fonts: geen verzoek naar Google, dus niets om AVG-gewijs te regelen.
import bodyFont from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import '../styles/global.css';

const props = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <Seo {...props} />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#hoofdinhoud">Naar de inhoud</a>
    <Header />
    <main id="hoofdinhoud" tabindex="-1">
      <slot />
    </main>
    <Footer />


  </body>
</html>
