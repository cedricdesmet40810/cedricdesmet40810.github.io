---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../config.js';

/**
 * Voorlopig één verhaal, volledig verteld. Elk afgerond traject krijgt
 * hier zijn eigen sectie, in hetzelfde ritme: situatie, oplossing, resultaat.
 */

const geleverd = [
  'Een rapportage-app op maat, volledig in de branding van To B-Seen',
  'Foto’s en kernwoorden ter plaatse, de AI schrijft het verslag',
  'AI die de schrijfstijl van elke expert leert en overneemt',
  'Een centraal admin-portaal waarin alle verslagen samenkomen',
  'Gekoppeld aan de software die er al stond',
];

const caseSchema = {
  '@type': 'Article',
  '@id': `${SITE.url}/ons-werk/#to-b-seen`,
  headline: 'To B-Seen: een rapportage-app die 3 uur schrijfwerk per verslag overneemt',
  author: { '@id': `${SITE.url}/#organization` },
  publisher: { '@id': `${SITE.url}/#organization` },
  about: {
    '@type': 'Organization',
    name: 'To B-Seen',
    description: 'Begeleidt de veiligheid van evenementen',
  },
};
---

<BaseLayout
  title="Ons werk"
  metaTitle="Ons werk: de rapportage-app van To B-Seen"
  description="Wat Auxilia bouwt en wat het opbrengt. Bij To B-Seen staat het verslag klaar zodra de rondgang is afgerond: 3 uur schrijfwerk per verslag die terug naar klanten gaat."
  schema={[caseSchema]}
  breadcrumbs={[{ name: 'Ons werk', href: '/ons-werk/' }]}
>
  <PageHero
    crumbs={[{ name: 'Ons werk', href: '/ons-werk/' }]}
    title="Onze succesverhalen"
    lead="We zijn pas gestart, dus deze pagina telt één traject. We vertellen het liever eerlijk en volledig dan dat we het opblazen. Elk volgend project komt hier bij."
    beeld="/hero-ons-werk.webp"
    beeldVrij={true}
    beeldAlt="Illustratie: iemand naast een verslag dat zichzelf invult, met een stapel afgewerkte verslagen"
  />

  <!-- ========================================================== de case -->
  <section class="section band-paper">
    <div class="container">
      <div class="case__kop reveal">
        <div class="case__kop-tekst">
          <p class="eyebrow">To B-Seen · eventveiligheid</p>
          <h2>Van uren schrijfwerk na elke rondgang naar een verslag dat klaarstaat</h2>
        </div>
        <!-- JPG met witte achtergrond; multiply maskeert dat op de witte band.
             Bij de klant een PNG/SVG met transparantie opvragen. -->
        <a href="https://www.tob-seen.be/" target="_blank" rel="noopener">
          <img
            src="/tobseen-logo.jpg"
            alt="To B-Seen — safety solutions for events"
            width="190"
            style="mix-blend-mode: multiply"
          />
        </a>
      </div>

      <div class="split split--top">
        <div class="reveal">
          <h3>De situatie</h3>
          <p>
            To B-Seen begeleidt de veiligheid van evenementen. Bij elk event
            hoort een rondgang: ter plaatse notities maken en foto’s nemen,
            en achteraf nog uren aan de slag om daar een volledig verslag van
            te maken. Dat schrijfwerk gebeurde meestal ’s avonds of pas dagen
            later, wanneer de details al minder scherp zijn. En het kwam
            bovenop het werk waarvoor klanten hen eigenlijk bellen.
          </p>
          <h3>Wat we bouwden</h3>
          <p>
            Een rapportage-app op maat, volledig in hun eigen branding. Bij
            elke stap van de rondgang neemt de expert foto’s en noteert een
            paar kernwoorden. Meer is niet nodig. De AI schrijft die
            kernwoorden uit tot volzinnen en bundelt alle stappen tot één
            gestructureerd verslag in hun eigen sjabloon.
          </p>
          <p>
            Die AI schrijft niet in een generieke stijl. Hij leert uit
            eerdere verslagen van dezelfde expert en neemt de woordkeuze en
            toon van de persoon én het bedrijf over. Voor de lezer is niet te
            zien dat AI meeschreef.
          </p>
          <p>
            Daarnaast bouwden we een centraal admin-portaal waarin alle
            verslagen samenkomen. Het team kan ze daar nalezen en bijsturen,
            handmatig of met AI. Zo verdwijnen verslagen niet langer in
            mailboxen, losse documenten of verschillende systemen.
          </p>
        </div>

        <div class="reveal">
          <div class="panel">
            <h3 class="panel__title">Wat er staat</h3>
            <ul class="checklist">
              {
                geleverd.map((g) => (
                  <li>
                    <Icon name="check" size={18} />
                    {g}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================== het resultaat -->
  <section class="section case__cijferband">
    <div class="container case__cijfer reveal">
      <div>
        <span class="case__big">3 uur</span>
        <span class="case__label">
          per verslag uitgespaard. Het verslag staat klaar voor de agent.
        </span>
      </div>
      <div>
        <p>
          Met meerdere rondgangen per expert loopt dat op weekbasis al snel
          op tot een volledige werkdag. Die tijd gaat opnieuw naar hun
          klanten, in plaats van naar administratie.
        </p>
      </div>
    </div>
  </section>

  <!--
    Zodra To B-Seen een quote geeft: hier een blockquote met naam en rol,
    in de stijl van een band-teal statement. Geen quote verzinnen.
  -->

  <!-- ================================================== zo werken we ook -->
  <section class="section band-sand">
    <div class="container split split--top">
      <div class="reveal">
        <p class="eyebrow">Wat dit voor jou betekent</p>
        <h2>Bij jou beginnen we ook bij één proces</h2>
        <p>
          Niet met een groot, kostelijk plan, maar met één proces dat het
          meeste tijd van je wegneemt. We bouwen dat volledig naar jouw noden
          en sturen bij tot je tevreden bent.
        </p>
        <a href="/#werkwijze" class="link-arrow">
          Zo pakken we dat aan
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="reveal">
        <div class="panel">
          <h3 class="panel__title">Dezelfde afspraken als bij To B-Seen</h3>
          <ul class="checklist">
            <li>
              <Icon name="check" size={18} />
              Vaste prijs en vaste deadline, vooraf
            </li>
            <li>
              <Icon name="check" size={18} />
              Gebouwd op de software die je al gebruikt
            </li>
            <li>
              <Icon name="check" size={18} />
              Je team leert ermee werken voor we vertrekken
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Het volgende verhaal"
    title="Misschien staat jouw bedrijf hier straks?"
    text="Vertel ons wat je doet en waar jij hulp kan gebruiken. Dan hoor je wat wij zouden doen en hoe we het zouden aanpakken."
    secondary={{ label: 'Bekijk de oplossingen', href: '/oplossingen/' }}
  />
</BaseLayout>

<style>
  .case__kop {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .case__kop-tekst {
    max-width: 760px;
  }

  .case__kop h2 {
    margin-top: 14px;
  }


  .split h3 {
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    margin-bottom: 10px;
  }

  .split h3:not(:first-child) {
    margin-top: 32px;
  }

  .split p {
    color: var(--ink-soft);
  }

  .panel__title {
    margin-bottom: 20px;
  }

  /* --------------------------------------------------------- resultaat --- */

  .case__cijferband {
    background: var(--clay-soft);
  }

  .case__cijfer {
    display: grid;
    gap: clamp(40px, 5vw, 72px);
    align-items: center;
  }

  @media (min-width: 920px) {
    .case__cijfer {
      grid-template-columns: 1fr 1fr;
    }
  }

  .case__big {
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 0.95;
    font-size: clamp(4rem, 9.5vw, 8rem);
    color: var(--clay-700);
  }

  .case__label {
    display: block;
    margin-top: 20px;
    font-size: 1.08rem;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 40ch;
  }

  .case__cijfer p {
    color: var(--ink-soft);
    font-size: 1.05rem;
  }
</style>
