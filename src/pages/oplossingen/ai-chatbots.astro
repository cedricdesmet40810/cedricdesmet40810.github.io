---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import Icon from '../../components/Icon.astro';
import ChatDemo from '../../components/ChatDemo.astro';

const faq = [
  {
    q: 'Verzint de chatbot antwoorden?',
    a: 'De chatbot zoekt in je documenten en vermeldt de bron bij zijn antwoord. We richten hem erop in om ontbrekende informatie te melden en testen dat met jullie vragen. Met de bronvermelding kun je het antwoord controleren; fouten blijven mogelijk.',
  },
  {
    q: 'Welke bestanden kan hij lezen?',
    a: 'PDF’s, Word-documenten, Excel-bestanden, PowerPoints, pagina’s van je website en tekst uit je CRM of ticketsysteem. Gescande documenten kunnen ook, al hangt de kwaliteit dan af van hoe goed de scan is.',
  },
  {
    q: 'Blijven onze documenten privé?',
    a: 'We leggen per project vast waar je bestanden worden verwerkt, wie toegang heeft en welke afspraken gelden met de gekozen leveranciers, ook over eventueel gebruik voor modeltraining. We bespreken waar verwerking binnen Europa mogelijk is.',
  },
  {
    q: 'Kan niet iedereen dan alles zien?',
    a: 'We spreken af welke documenten voor welke gebruikers toegankelijk mogen zijn. Daarop richten we de toegangsrechten in, waar mogelijk gekoppeld aan je bestaande gebruikersgroepen. We testen die toegang samen voor we live gaan.',
  },
  {
    q: 'Wat als onze documenten verouderd zijn?',
    a: 'De antwoorden hangen af van de documenten die je beschikbaar maakt. Daarom bekijken we samen welke versies actueel zijn en spreken we af hoe wijzigingen worden bijgewerkt.',
  },
  {
    q: 'Kunnen klanten er ook mee chatten?',
    a: 'Dat kan, met een aparte set documenten en strengere grenzen dan de interne versie. Vaak begint een kmo intern, omdat je daar sneller ziet wat er goed en fout gaat zonder dat een klant het merkt.',
  },
];

const gebruik = [
  {
    icon: 'search',
    t: 'Je eigen kennisbank doorzoeken',
    d: 'Handleidingen, procedures, oude offertes en productfiches. Eén vraag in plaats van tien minuten zoeken in mappen.',
  },
  {
    icon: 'mail',
    t: 'Vragen van klanten beantwoorden',
    d: 'Levertijden, garantievoorwaarden, openingsuren. Op je website of in je mailbox, ook om tien uur ’s avonds.',
  },
  {
    icon: 'users',
    t: 'Nieuwe collega’s inwerken',
    d: 'Iemand die net begint durft het niet vijf keer te vragen. Aan een assistent wel.',
  },
  {
    icon: 'euro',
    t: 'Prijzen en marges opzoeken',
    d: 'Uit je eigen prijslijst, met de kortingsregels die bij die klant horen.',
  },
];

const stappen = [
  {
    t: 'We verzamelen je bronnen',
    d: 'Samen kiezen we welke documenten mee mogen: mappen op de server, SharePoint, je website, je CRM. We gaan niet zomaar alles inlezen. Wat verouderd is, blijft eruit.',
  },
  {
    t: 'We maken ze doorzoekbaar',
    d: 'We maken de documenten doorzoekbaar, zodat de assistent relevante passages kan ophalen bij een vraag.',
  },
  {
    t: 'We testen met echte vragen',
    d: 'Je team test de assistent een week lang met vragen uit de praktijk. Bij fouten bekijken we zowel de gebruikte bron als de manier waarop het antwoord tot stand kwam.',
  },
  {
    t: 'Hij gaat live waar je werkt',
    d: 'In Teams, op je website, in je mailbox of in een eigen scherm. We spreken af hoe we de documenten en de assistent daarna bijwerken.',
  },
];
---

<ServiceLayout
  slug="ai-chatbots"
  title="AI-chatbots op je eigen data"
  h1="Een AI-chatbot die antwoordt uit jouw documenten"
  metaTitle="AI-chatbot op je eigen data laten bouwen"
  description="Laat een AI-chatbot bouwen die antwoordt uit je eigen documenten, prijslijsten en procedures, met bronvermelding. Voor kmo’s in de Kempen en heel België."
  lead="We koppelen de assistent aan jullie documenten en richten de toegang in voor je team. Zo sluit hij aan op de informatie en werkwijze van je bedrijf."
  beeld="/hero-chatbots.jpg"
  beeldAlt="Illustratie: iemand met chatvensters en documentmappen"
  highlights={[
    'Zoekt antwoorden in jouw documenten',
    'Bronvermelding om antwoorden te controleren',
    'Ingericht om ontbrekende informatie te melden',
    'Toegangsrechten afgestemd op je team',
    'Draait in Teams, op je site of in je mailbox',
  ]}
  faq={faq}
>
  <!-- ==================================================== het verschil -->
  <section class="section band-paper">
    <div class="container split">
      <div class="reveal">
        <p class="eyebrow">Het verschil</p>
        <h2>Aangesloten op de informatie van je bedrijf</h2>
        <p>
          Een algemene chatbot kan met bestanden werken, maar is daarmee nog niet
          ingericht op jouw bedrijf. Welke documenten zijn actueel, wie mag welke
          informatie zien en waar gebruikt je team de assistent? Die keuzes bepalen hoe
          bruikbaar hij is.
        </p>
        <p>
          Wij koppelen de assistent aan de gekozen bronnen en testen hem met vragen uit
          jullie praktijk. Hij haalt relevante informatie op en vermeldt de bron bij zijn
          antwoord. Zo kan je controleren waarop het antwoord is gebaseerd. Fouten blijven
          mogelijk.
        </p>
      </div>
      <div class="reveal">
        <ChatDemo />
      </div>
    </div>
  </section>

  <!-- ======================================================== gebruik -->
  <section class="section band-sand">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Waarvoor kmo’s het inzetten</p>
        <h2>Waar hij meestal terechtkomt</h2>
      </div>
      <div class="grid grid--4 reveal">
        {
          gebruik.map((g) => (
            <article class="card">
              <span class="icon-tile">
                <Icon name={g.icon} />
              </span>
              <h3>{g.t}</h3>
              <p>{g.d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================================================= aanpak -->
  <section class="section band-teal">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Hoe we het bouwen</p>
        <h2>Van een map vol documenten naar een assistent voor je team</h2>
      </div>
      <ol class="numbered reveal">
        {
          stappen.map((s, i) => (
            <li>
              <span class="numbered__n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ======================================================== grenzen -->
  <section class="section band-sand">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">De grenzen</p>
        <h2>Wat een chatbot op je data níet oplost</h2>
        <p class="lead">
          Liever vooraf duidelijk dan achteraf teleurgesteld.
        </p>
      </div>
      <div class="grid grid--3 reveal">
        <article class="card limit">
          <h3>Rommelige documenten</h3>
          <p>
            Staan er drie versies van dezelfde prijslijst op je server, dan weet de
            assistent niet vanzelf welke de juiste is. Samen bepalen we welke versie
            gebruikt moet worden en hoe je die actueel houdt.
          </p>
        </article>
        <article class="card limit">
          <h3>Beslissingen nemen</h3>
          <p>
            Hij zoekt op en vat samen. Of je die korting geeft, beslis jij. We
            bouwen bewust geen assistent die zelfstandig toezeggingen doet aan
            klanten.
          </p>
        </article>
        <article class="card limit">
          <h3>Kennis die nergens staat</h3>
          <p>
            Wat alleen in het hoofd van je meest ervaren collega zit, kan hij
            niet weten. Dat is meteen een goede reden om het eindelijk eens op
            te schrijven.
          </p>
        </article>
      </div>
    </div>
  </section>
</ServiceLayout>

<style>
  .limit h3 {
    margin-bottom: 12px;
  }
</style>
