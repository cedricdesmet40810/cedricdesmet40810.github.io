---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import StepScene from '../components/StepScene.astro';
import Faq from '../components/Faq.astro';
import { SERVICES, SITE } from '../config.js';

// De vragen die mensen ons echt stellen zodra ze horen wat we doen.
const faq = [
  {
    q: 'Wat kan zo’n AI nu concreet voor ons doen?',
    a: 'Het meeste kantoorwerk is lezen, schrijven en overtypen: offertes opmaken, mails sorteren en beantwoorden, verslagen schrijven, gegevens van het ene systeem naar het andere brengen, vragen beantwoorden uit je eigen documenten. Daar is AI sterk in. Beslissingen nemen, klanten bellen en rommel opruimen blijven mensenwerk.',
  },
  {
    q: 'Hoe bouwen jullie zoiets?',
    a: 'We hangen AI aan de software die je al gebruikt: Microsoft 365, Google Workspace, SharePoint, Odoo, Billit. Eerst één proces, van begin tot eind. Pas als dat draait en je team ermee weg is, kijken we naar het volgende.',
  },
  {
    q: 'Wat kunnen we zelf al doen, zonder jullie?',
    a: 'Meer dan je denkt. Voor losse taken, een mail herschrijven of een tekst samenvatten, volstaat ChatGPT of Copilot. Daar heb je ons niet voor nodig, en dat zeggen we er ook bij. Wij komen in beeld zodra het aan je systemen moet hangen en er elke dag betrouwbaar hetzelfde uit moet komen.',
  },
  {
    q: 'Wat kost dat?',
    a: 'We starten met een korte scan van je processen. Daarna krijg je één vast bedrag voor het hele traject, vooraf. Geen uurtje-factuurtje. Wat het precies wordt, hangt af van hoeveel systemen we moeten aansluiten.',
  },
  {
    q: 'Moet ons team technisch zijn?',
    a: 'Nee. Niemand hoeft te kunnen programmeren en je hebt geen IT-afdeling nodig. Wij doen het technische werk en leggen in gewone taal uit wat er gebeurt. Je team leert werken met het resultaat.',
  },
  {
    q: 'Wat gebeurt er met onze gegevens?',
    a: 'Je data blijft van jou. We spreken vooraf af welke bestanden gebruikt worden, waar ze staan en wie erbij kan. We werken volgens de GDPR en houden rekening met de Europese AI Act. Waar het kan, draait de verwerking op Europese servers.',
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE.url}/#faq`,
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const servicesSchema = SERVICES.map((s) => ({
  '@type': 'Service',
  '@id': `${SITE.url}/oplossingen/${s.slug}/#service`,
  name: s.title,
  description: s.excerpt,
  serviceType: s.short,
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: { '@type': 'Country', name: 'België' },
  url: `${SITE.url}/oplossingen/${s.slug}/`,
}));


const stappen = [
  {
    scene: 'werkvloer',
    t: 'We beginnen bij jou op de werkvloer',
    d: 'We geven geen presentatie over AI, maar we willen identificeren wat je bedrijf eigenlijk doet en wat de core business is. Welke tools je bedrijf gebruikt, en waar AI mogelijks een hulp kan zijn om je dagelijkse taken te versnellen.',
  },
  {
    scene: 'systemen',
    t: 'We bouwen toepassingen op de tools die je al hebt',
    d: 'Je boekhoudpakket, je mailbox, je tools, je CRM en je mappen blijven gewoon staan. We koppelen AI aan Microsoft 365, Google Workspace, SharePoint, Odoo of Billit en bouwen skills die je dagdagelijkse handelingen nabootsen en versnellen.',
  },
  {
    scene: 'team',
    t: 'We geven het in handen van je team',
    d: 'Wij overhandigen de skills en workflows aan jou en je team, en geven uitleg over hoe je ze het beste gebruikt. We tonen waar het waarde heeft om een taak op een vast schema te laten lopen, en waar AI het grote werk doet terwijl iemand van jullie telkens nakijkt.',
  },
  {
    scene: 'buurt',
    t: 'Wij volgen het proces op en helpen je verder bij onduidelijkheden',
    d: 'Bedrijven veranderen, nieuwe tools worden geïntroduceerd. Wij houden deze draaiend voor jou en breiden uit wat goed werkt. Zo moet je niemand in huis aannemen op je loonlijst en ben je altijd up-to-date.',
  },
];

const producten = [
  {
    vraag: 'Weet je dat er iets moet, maar niet wat?',
    naam: 'Scan',
    d: 'We lichten je processen door. Je krijgt een rapport met de kansen, de berekening erbij en een volgorde van aanpak. Het rapport is van jou, ook zonder vervolg.',
    href: '/oplossingen/kostenbesparing/',
    label: 'Hoe de scan werkt',
  },
  {
    vraag: 'Eén proces dat blijft vreten aan je week?',
    naam: 'Bouw',
    d: 'Een app op maat die AI gebruikt waar dat loont, zoals de rapportage-app van To B-Seen. Werkend opgeleverd op de afgesproken datum, voor het afgesproken bedrag.',
    href: '/oplossingen/apps-op-maat/',
    label: 'Bekijk wat we bouwen',
  },
  {
    vraag: 'Zit jullie kennis verspreid over mappen en hoofden?',
    naam: 'Chat',
    d: 'Een assistent die antwoordt uit je eigen documenten, met bronvermelding.',
    href: '/oplossingen/ai-chatbots/',
    label: 'Zo werkt de chatbot',
  },
];

// Wat ons anders maakt dan een gewoon IT-bureau of een AI-abonnement.
const waarom = [
  {
    icon: 'users',
    t: 'Eén aanspreekpunt',
    d: 'AI én IT bij dezelfde mensen. Geen leveranciers die naar elkaar wijzen als er iets hapert.',
  },
  {
    icon: 'euro',
    t: 'Vaste prijs, vaste deadline',
    d: 'Je weet vooraf wat het kost en wanneer het klaar is. Geen uurtje-factuurtje achteraf.',
  },
  {
    icon: 'plug',
    t: 'Op je eigen systemen',
    d: 'Microsoft 365, Odoo, Billit, je eigen mappen. Je hoeft niets te vervangen of opnieuw te leren.',
  },
  {
    icon: 'lock',
    t: 'Je data blijft van jou',
    d: 'Vooraf afgesproken welke bestanden meespelen en wie erbij kan. Volgens de GDPR, waar het kan op Europese servers.',
  },
  {
    icon: 'chat',
    t: 'Geautomatiseerd, maar persoonlijk',
    d: 'Het werk draait vanzelf, maar je spreekt nog altijd de mensen die het gebouwd hebben.',
  },
  {
    icon: 'check',
    t: 'We zeggen het als je ons niet nodig hebt',
    d: 'Volstaat een gewoon AI-abonnement voor wat je wil doen? Dan zeggen we dat, in plaats van je iets te verkopen.',
  },
];

---

<BaseLayout
  title="Auxilia · AI en IT voor KMO’s in de Kempen"
  exactTitle={true}
  description="AI-chatbots op je eigen data, apps op maat en automatisering voor KMO’s. Eén aanspreekpunt voor AI én IT. Vaste prijs, vaste deadline. Plan een kennismaking."
  schema={[faqSchema, ...servicesSchema]}
>
  <!-- ====================================================== hero (teal) -->
  <section class="hero band-teal">
    <div class="container hero__inner">
      <div class="hero__tekst">
        <h1>Meer tijd voor het echte werk</h1>
        <p class="hero__lead">
          Papierwerk slorpt je dagen op. Auxilia bouwt AI en apps op maat die
          het overnemen, in de software die je al gebruikt, met je team aan het
          stuur.
        </p>
        <div class="btn-row hero__actions">
          <a href={SITE.bookingUrl || '/contact/'} class="btn btn--primary btn--xl">
            Plan 30 minuten
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <p class="hero__sub">Vaste prijs · vaste deadline · je data blijft van jou</p>
      </div>

      <img
        class="hero__beeld"
        src="/hero-thuiswerk.jpg"
        width="1400"
        height="781"
        fetchpriority="high"
        decoding="async"
        alt=""
      />
    </div>
  </section>

  <!-- ==================================================== integraties -->
  <section class="section--tight band-sand strip">
    <div class="container strip__row">
      <p class="strip__label">Sluit aan op wat je al gebruikt</p>
      <ul class="strip__list">
        <li>
          <svg class="strip__logo" viewBox="0 0 21 21" aria-hidden="true">
            <rect width="10" height="10" fill="#F25022"></rect>
            <rect x="11" width="10" height="10" fill="#7FBA00"></rect>
            <rect y="11" width="10" height="10" fill="#00A4EF"></rect>
            <rect x="11" y="11" width="10" height="10" fill="#FFB900"></rect>
          </svg>
          Microsoft 365
        </li>
        <li>
          <svg class="strip__logo" viewBox="0 0 48 48" aria-hidden="true">
            <path
              fill="#EA4335"
              d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
            ></path>
            <path
              fill="#4285F4"
              d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
            ></path>
            <path
              fill="#FBBC05"
              d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
            ></path>
            <path
              fill="#34A853"
              d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
            ></path>
          </svg>
          Google Workspace
        </li>
        <li>
          <!-- Vereenvoudigd merkteken; vervang bij lancering door het officiële logo. -->
          <svg class="strip__logo" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="10" cy="9" r="8" fill="#036C70"></circle>
            <circle cx="17.5" cy="13.5" r="6" fill="#1A9BA1"></circle>
            <circle cx="12" cy="19" r="4.5" fill="#37C6D0"></circle>
          </svg>
          SharePoint
        </li>
        <li>
          <svg class="strip__logo" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5" fill="none" stroke="#714B67" stroke-width="5"></circle>
          </svg>
          Odoo
        </li>
        <li>
          <!-- Officieel Billit-icoon (origami-vogel), verkleind ingebed. -->
          <img class="strip__logo" src="data:image/png;base64," alt="" width="18" height="18" />
          Billit
        </li>
      </ul>
    </div>
  </section>

  <!-- ========================================================== stappen -->
  <section class="section band-sand">
    <div class="container">
      <div class="stappen__layout">
        <aside class="stappen__zij reveal">
          <div class="section-head">
            <p class="eyebrow">Hoe we werken</p>
            <h2 class="stappen__kop">Auxilia AI zorgt ervoor dat AI ten dienste staat van uw hele organisatie.</h2>
          </div>
          <img
            class="stappen__beeld"
            src="/aan-de-slag.jpg"
            width="672"
            height="900"
            loading="lazy"
            decoding="async"
            alt=""
          />
        </aside>

        <ol class="bigsteps">
          {
            stappen.map((s, i) => (
              <li class="bigstep reveal">
                <div class="bigstep__visual" aria-hidden="true">
                  <StepScene name={s.scene} />
                  <span class="bigstep__n">{String(i + 1).padStart(2, '0')}</span>
                </div>
                <div class="bigstep__body">
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ==================================================== succesverhalen -->
  <section class="section succesband">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Succesverhalen</p>
        <h2>Kleine KMO’s die we vandaag al hebben geholpen</h2>
      </div>

      <!-- Elk afgerond traject krijgt hier zo'n kaart. -->
      <article class="card succes reveal">
        <div class="succes__body">
          <p class="succes__klant">To B-Seen · eventveiligheid</p>
          <h3>Elk event een verslag, zonder dat iemand het thuis nog manueel moet typen</h3>
          <p>
            To B-Seen begeleidt de veiligheid van evenementen. Bij elk event
            doen zij een rondgang en schrijven ze daarover een verslag. Dat
            verslag werd meestal thuis na de uren geschreven. Vandaag zorgt AI
            ervoor dat het voor hen klaarstaat.
          </p>
          <a href="/ons-werk/" class="link-arrow">
            Lees het hele verhaal
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <img
          class="succes__shot"
          src="/tobseen-app.png"
          width="1440"
          height="1080"
          loading="lazy"
          decoding="async"
          alt="De rapportage-app van To B-Seen op een telefoon: de observaties van een inspectieronde onder elkaar, met ernaast hoe AI een losse notitie uitschrijft tot een zin in het verslag."
        />
      </article>
    </div>
  </section>

  <!-- =========================================================== waarom -->
  <section class="section band-paper">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <p class="eyebrow eyebrow--center">Waarom Auxilia</p>
        <h2>Waarom kiezen voor ons?</h2>
      </div>

      <div class="grid grid--3 reveal">
        {
          waarom.map((w) => (
            <article class="card waarom">
              <span class="waarom__icoon" aria-hidden="true">
                <Icon name={w.icon} size={22} />
              </span>
              <h3 class="waarom__titel">{w.t}</h3>
              <p>{w.d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================== producten -->
  <section class="section band-paper">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <p class="eyebrow eyebrow--center">Kies je vertrekpunt</p>
        <h2>Drie van onze opties</h2>
      </div>

      <div class="grid grid--3 reveal">
        {
          producten.map((p) => (
            <article class="card product">
              <p class="product__vraag">{p.vraag}</p>
              <h3 class="product__naam">
                <span class="product__mark" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20">
                    <path
                      d="M5 14 L12 7.5 L19 14"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                {p.naam}
              </h3>
              <p class="product__d">{p.d}</p>
              <a href={p.href} class="link-arrow">
                {p.label}
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>

      <!-- De vaste partner: breed, want dit is het einddoel. -->
      <article class="wacht reveal">
        <div>
          <p class="product__vraag">Liever iemand die er blijvend op let?</p>
          <h3 class="product__naam product__naam--light">
            <span class="product__mark product__mark--light" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20">
                <path
                  d="M5 14 L12 7.5 L19 14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            Partner
          </h3>
          <p class="wacht__d">
            Ons vaste partnerschap: wij houden de wacht over je AI én de rest
            van je IT. Werkplekken, licenties, back-ups, beveiliging en alles
            wat hapert. Eén nummer, vast maandbedrag.
          </p>
        </div>
        <a href="/oplossingen/it-beheer/" class="btn btn--secondary">
          Zo werkt het partnerschap
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </article>
    </div>
  </section>

  <!-- ============================================================= faq -->
  <section class="section band-sand" id="faq">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Veelgestelde vragen</p>
        <h2>Wat mensen ons als eerste vragen</h2>
        <p class="lead">
          Staat je vraag er niet bij? De rest beantwoorden we bij een koffie.
        </p>
      </div>
      <div class="reveal">
        <Faq items={faq} />
      </div>
    </div>
  </section>

  <!-- ===================================================== slot (teal) -->
  <section class="section band-teal slot">
    <div class="container">
      <div class="slot__head reveal">
        <h2 class="statement">Na dertig minuten weet je het</h2>
        <p class="lead">
          Eén gesprek, online of bij jou op kantoor. Dit neem je sowieso mee
          naar huis:
        </p>
      </div>

      <div class="slot__grid reveal">
        <ul class="checklist slot__list">
          <li>
            <Icon name="check" size={18} />
            Een beeld van waar AI bij jullie het snelst rendeert
          </li>
          <li>
            <Icon name="check" size={18} />
            Wat je beter eerst zelf probeert, zonder ons
          </li>
          <li>
            <Icon name="check" size={18} />
            Of het de moeite is om verder te praten
          </li>
        </ul>

        <div class="slot__cta">
          <a href={SITE.bookingUrl || '/contact/'} class="btn btn--primary btn--xl">
            Plan 30 minuten
            <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a href="/aanpak/" class="btn btn--secondary">Lees eerst de aanpak</a>
        </div>
      </div>

      <p class="slot__data reveal">
        <Icon name="lock" size={16} />
        Je data blijft van jou. GDPR en de Europese AI Act, vanaf dag één.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ------------------------------------------------------------- hero --- */

  .hero {
    position: relative;
    overflow: hidden;
    /* de donkere header loopt visueel door in het hero */
    margin-top: -78px;
    padding-top: calc(78px + clamp(3.5rem, 6vw, 6rem));
    padding-bottom: clamp(3.5rem, 6vw, 6rem);
    background: var(--teal);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    max-width: 1180px;
  }

  /* Tekst links, beeld rechts. Het beeld krijgt iets meer ruimte dan de
     tekst, want de figuur zit midden in het kader. */
  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr 1.05fr;
    }
  }

  .hero h1 {
    font-size: clamp(2.6rem, 5.4vw, 4.4rem);
    max-width: 13ch;
  }

  .hero__lead {
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    line-height: 1.55;
    color: rgba(250, 247, 242, 0.8);
    max-width: 44ch;
    margin: 24px 0 0;
  }

  .hero__actions {
    margin-top: 36px;
  }

  .btn--xl {
    padding: 18px 38px;
    font-size: 1.08rem;
  }

  .hero__sub {
    margin: 20px 0 0;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    color: rgba(250, 247, 242, 0.75);
    max-width: none;
  }

  .hero__beeld {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r-lg);
  }

  /* ------------------------------------------------------------ strip --- */

  .strip {
    border-bottom: 1px solid var(--line-soft);
    padding-block: 28px;
  }

  .strip__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 14px 40px;
  }

  .strip__label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0;
    max-width: none;
  }

  .strip__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 32px;
  }

  .strip__list li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 1.12rem;
    color: var(--ink-soft);
  }

  .strip__logo {
    width: 18px;
    height: 18px;
    flex: none;
  }

  /* Kop en beeld blijven links staan terwijl de stappen rechts passeren. */
  .stappen__layout {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
  }

  @media (min-width: 980px) {
    .stappen__layout {
      grid-template-columns: 0.82fr 1.18fr;
      align-items: start;
    }

    .stappen__zij {
      position: sticky;
      /* onder de plakkende header, met wat lucht */
      top: 108px;
    }
  }

  .stappen__zij {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vw, 32px);
  }

  .stappen__zij .section-head { margin-bottom: 0; }

  /* Een kolom die blijft staan mag niet hoger worden dan het scherm, anders
     schuift de kop er bovenaan uit. Vandaar kleiner dan een gewone sectiekop —
     en hij hoort de kaarten rechts ook niet te overstemmen. */
  .stappen__kop {
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
  }

  .stappen__beeld {
    display: block;
    width: 100%;
    max-width: 250px;
    height: auto;
    border-radius: var(--r);
  }

  /* ---------------------------------------------------------- bigsteps --- */

  .bigsteps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 24px;
  }

  .bigstep {
    display: grid;
    gap: 22px;
    background: var(--paper);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow);
    padding: clamp(26px, 3.2vw, 40px);
  }

  /* In een smallere kolom valt de strip-afwisseling weg: elke kaart krijgt
     dezelfde opbouw, tegel links en tekst rechts. */
  @media (min-width: 560px) {
    .bigstep {
      grid-template-columns: 132px 1fr;
      align-items: center;
      gap: clamp(24px, 3vw, 36px);
    }
  }

  .bigstep__visual {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    max-width: 132px;
    border-radius: 20px;
