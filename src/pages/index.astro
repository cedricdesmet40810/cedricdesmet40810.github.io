---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SiteImage from '../components/SiteImage.astro';
import Faq from '../components/Faq.astro';
import { SERVICES, SITE } from '../config.js';

// De vragen die mensen ons echt stellen zodra ze horen wat we doen.
const faq = [
  {
    q: 'Wat kan zo’n AI nu concreet voor ons doen?',
    a: 'Het meeste kantoorwerk is lezen en schrijven: offertes opmaken, mails sorteren en beantwoorden, verslagen schrijven, gegevens van het ene systeem naar het andere brengen, vragen beantwoorden uit je eigen documenten. Daar is AI sterk in. Beslissingen nemen, klanten bellen en producten afleveren blijven werk voor mensen.',
  },
  {
    q: 'Wat kost dat?',
    a: 'We starten met een korte scan van je processen. Daarvoor rekenen we een vast bedrag aan, afgesproken voor we beginnen. Hoe groot je bedrijf is of hoeveel processen je hebt, maakt voor die prijs niets uit. Daarna bekijken we samen welke processen de moeite waard zijn om aan te pakken, en spreken we de prijs af voor de verdere stappen.',
  },
  {
    q: 'Moet ons team technisch zijn?',
    a: 'Nee. Niemand hoeft te kunnen programmeren en je hebt geen IT-afdeling nodig. Wij doen het technische werk en leggen in gewone taal uit wat er gebeurt. Je team leert werken met het resultaat.',
  },
  {
    q: 'Wat gebeurt er met onze gegevens?',
    a: 'Je data blijft van jou. We spreken vooraf af welke bestanden gebruikt worden, waar ze staan en wie erbij kan. We werken volgens de GDPR en houden rekening met de Europese AI Act. Waar het kan, draait de verwerking op Europese servers.',
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE.url}/#faq`,
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const servicesSchema = SERVICES.map((s) => ({
  '@type': 'Service',
  '@id': `${SITE.url}/oplossingen/${s.slug}/#service`,
  name: s.title,
  description: s.excerpt,
  serviceType: s.short,
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: { '@type': 'Country', name: 'België' },
  url: `${SITE.url}/oplossingen/${s.slug}/`,
}));


const stappen = [
  {
    scene: 'werkvloer',
    beeld: '/stap-werkvloer.jpg',
    t: 'We beginnen bij jou op de werkvloer',
    d: 'We willen identificeren wat je bedrijf eigenlijk doet en wat de corebusiness is. We bekijken welke tools je bedrijf gebruikt en waar AI mogelijk een hulp kan zijn om je dagelijkse taken te versnellen.',
  },
  {
    scene: 'systemen',
    beeld: '/stap-tools.jpg',
    t: 'We bouwen toepassingen op de tools die je al hebt',
    d: 'Je boekhoudpakket, je mailbox, je CRM en je mappen blijven staan waar ze staan. We koppelen er AI aan vast en bouwen de handelingen na die je team vandaag manueel doet.',
  },
  {
    scene: 'team',
    beeld: '/stap-team.jpg',
    t: 'We geven het in handen van je team',
    d: 'Wij overhandigen de skills en workflows aan jou en je team, en leren jou hoe je ze het beste gebruikt. We tonen waar het waarde heeft om een taak op een vast schema te laten lopen, en waar AI het repetitieve werk doet terwijl iemand van jullie telkens nakijkt.',
  },
  {
    scene: 'buurt',
    beeld: '/stap-opvolgen.jpg',
    t: 'Wij volgen het proces op en helpen je verder bij onduidelijkheden',
    d: 'Bedrijven veranderen en tools ook. Wij houden het draaiend en bouwen uit wat werkt.',
  },
];

const producten = [
  {
    vraag: 'Weet je dat je iets moet doen met AI, maar niet wat?',
    naam: 'Scan',
    beeld: '/opl-kosten.jpg',
    d: 'We lichten je processen door. Je krijgt een rapport/plan met de kansen, de berekeningen en een volgorde van aanpak.',
    href: '/oplossingen/kostenbesparing/',
    label: 'Hoe de scan werkt',
  },
  {
    vraag: 'Eén proces dat je wil aanpakken in je week?',
    naam: 'Bouw',
    beeld: '/opl-apps.jpg',
    d: 'Een app op maat die AI gebruikt waar dat loont. Werkend opgeleverd op de afgesproken datum, voor het afgesproken bedrag.',
    href: '/oplossingen/apps-op-maat/',
    label: 'Bekijk wat we bouwen',
  },
  {
    vraag: 'Nood aan een chatbot?',
    naam: 'Chat',
    beeld: '/opl-chatbots.jpg',
    d: 'Een assistent die antwoordt uit je eigen documenten, met bronvermelding.',
    href: '/oplossingen/ai-chatbots/',
    label: 'Zo werkt de chatbot',
  },
];

// Wat ons anders maakt dan een gewoon IT-bureau of een AI-abonnement.
const waarom = [
  {
    icon: 'users',
    t: 'Eén aanspreekpunt',
    d: 'AI én IT bij dezelfde mensen. Geen leveranciers die naar elkaar wijzen als er iets hapert.',
  },
  {
    icon: 'euro',
    t: 'Vaste prijs, vaste deadline',
    d: 'Je weet vooraf wat het kost en wanneer het klaar is. Geen uurtje-factuurtje achteraf.',
  },
  {
    icon: 'plug',
    t: 'Op je eigen systemen',
    d: 'Microsoft 365, Odoo, Billit, je eigen mappen. Je hoeft niets te vervangen of opnieuw te leren.',
  },
  {
    icon: 'check',
    t: 'We zeggen het als je ons niet nodig hebt',
    d: 'Volstaat een gewoon AI-abonnement voor wat je wil doen? Dan zeggen we dat, in plaats van je iets te verkopen.',
  },
  {
    icon: 'clock',
    t: 'Er wanneer jij ons nodig hebt',
    d: 'Gemaakt voor kleine kmo’s: je belt ons rechtstreeks, niet een ticketsysteem. Wij komen langs wanneer het jou past, niet wanneer het ons uitkomt.',
  },
];

---

<BaseLayout
  title="Auxilia · AI en IT voor kmo’s in de Kempen"
  exactTitle={true}
  description="AI-chatbots op je eigen data, apps op maat en automatisering voor kmo’s. Eén aanspreekpunt voor AI én IT. Vaste prijs, vaste deadline. Plan een kennismaking."
  schema={[faqSchema, ...servicesSchema]}
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__tekst">
        <p class="hero-badge">{SITE.tagline}</p>
        <h1>AI die voor je kmo werkt</h1>
        <p class="hero__lead">
          Offertes opmaken, verslagen schrijven, mails sorteren, gegevens van
          het ene systeem naar het andere sturen. Wij bouwen AI en apps op
          maat die dat voor jou overnemen. We gebruiken de software die je
          vandaag al gebruikt, met je eigen team aan het stuur.
        </p>
        <div class="btn-row hero__actions">
          <a href={SITE.bookingUrl || '/contact/'} class="btn btn--primary btn--xl">Plan 30 minuten <span class="arrow" aria-hidden="true">↗</span></a>
          <a href="#werkwijze" class="hero__more">Hoe we werken <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="hero__visual">
        <SiteImage class="hero__beeld" src="/hero-thuiswerk.jpg" width="1600" sizes="(max-width: 899px) 100vw, 47vw" fetchpriority="high" loading="eager" decoding="async" alt="Illustratie: iemand ontspannen in een zetel bij het raam, terwijl documenten zichzelf opstapelen" />
        <div class="hero__caption"><span class="hero__caption-icon"><Icon name="check" size={19} /></span><span>Met je eigen team aan het stuur.</span><span class="hero__caption-mark" aria-hidden="true">↗</span></div>
      </div>
    </div>
  </section>
  <section class="section--tight band-sand strip">
    <div class="container strip__row">
      <p class="strip__label">We integreren de software die jij al gebruikt</p>
      <ul class="strip__list">
        <li>
          <svg class="strip__logo" viewBox="0 0 21 21" aria-hidden="true">
            <rect width="10" height="10" fill="#F25022"></rect>
            <rect x="11" width="10" height="10" fill="#7FBA00"></rect>
            <rect y="11" width="10" height="10" fill="#00A4EF"></rect>
            <rect x="11" y="11" width="10" height="10" fill="#FFB900"></rect>
          </svg>
          Microsoft 365
        </li>
        <li>
          <svg class="strip__logo" viewBox="0 0 48 48" aria-hidden="true">
            <path
              fill="#EA4335"
              d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
            ></path>
            <path
              fill="#4285F4"
              d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
            ></path>
            <path
              fill="#FBBC05"
              d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
            ></path>
            <path
              fill="#34A853"
              d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
            ></path>
          </svg>
          Google Workspace
        </li>
        <li>
          <!-- Vereenvoudigd merkteken; vervang bij lancering door het officiële logo. -->
          <svg class="strip__logo" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="10" cy="9" r="8" fill="#036C70"></circle>
            <circle cx="17.5" cy="13.5" r="6" fill="#1A9BA1"></circle>
            <circle cx="12" cy="19" r="4.5" fill="#37C6D0"></circle>
          </svg>
          SharePoint
        </li>
        <li>
          <svg class="strip__logo" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5" fill="none" stroke="#714B67" stroke-width="5"></circle>
          </svg>
          Odoo
        </li>
        <li>
          <!-- Officieel Billit-icoon (origami-vogel), verkleind ingebed. -->
          <img class="strip__logo" src="data:image/png;base64," alt="" width="18" height="18" />
          Billit
        </li>
      </ul>
    </div>
  </section>


  <section class="section products-section">
    <div class="container">
      <div class="section-head"><p class="eyebrow">Kies je vertrekpunt</p><h2>Drie van onze opties</h2></div>
      <div class="products">
        {producten.map(p => (
          <article class="product">
            <div class="product__top"><h3 class="product__naam">{p.naam}</h3><a class="product__symbol" href={p.href} aria-label={`${p.naam}: ${p.label}`}><span aria-hidden="true">↗</span></a></div>
            <div class="product__visual"><SiteImage src={p.beeld} alt="" width="478" loading="lazy" sizes="(max-width: 700px) 100vw, 33vw" /></div>
            <div class="product__body"><p class="product__vraag">{p.vraag}</p><p class="product__d">{p.d}</p><a href={p.href} class="link-arrow">{p.label}<span class="arrow" aria-hidden="true">↗</span></a></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section succesband band-teal">
    <div class="container">
      <article class="succes">
        <div class="succes__body">
          <div class="section-head"><p class="eyebrow">Succesverhalen</p><h2>Waar hebben wij al geholpen?</h2></div>
          <p class="succes__klant">To B-Seen · eventveiligheid</p>
          <h3>Voor elk event een verslag zonder typen met behulp van AI</h3>
          <p>Foto’s en kernwoorden ter plaatse volstaan: AI schrijft het verslag, in de stijl van de expert zelf.</p>
          <a href="/ons-werk/" class="btn btn--secondary">Lees het hele verhaal <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
        <div class="succes__visual"><SiteImage class="succes__shot" src="/tobseen-app.png" width="1440" loading="lazy" decoding="async" alt="De rapportage-app van To B-Seen op een telefoon: de observaties van een inspectieronde onder elkaar, met ernaast hoe AI een losse notitie uitschrijft tot een zin in het verslag." /></div>
        <div class="succes__cijfers">
          <div><strong>3 uur</strong><span>bespaard per rondgang</span></div>
          <div><strong>1 werkdag</strong><span>per week terug gespendeerd aan klanten</span></div>
        </div>
      </article>
    </div>
  </section>

  <section class="section process-section" id="werkwijze">
    <div class="container stappen__layout">
      <div class="stappen__zij">
        <div class="section-head"><p class="eyebrow">Hoe we werken</p><h2 class="stappen__kop">Auxilia zorgt ervoor dat AI ten dienste staat van jou.</h2></div>
        <div class="stappen__visual"><SiteImage class="stappen__beeld" src="/aan-de-slag.jpg" width="522" loading="lazy" decoding="async" alt="" sizes="(max-width: 899px) 50vw, 28vw" /></div>
      </div>
      <ol class="bigsteps">
        {stappen.map((s, i) => (
          <li class="bigstep">
            <span class="bigstep__number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="bigstep__body"><h3>{s.t}</h3><p>{s.d}</p></div>
            <SiteImage class="bigstep__beeld" src={s.beeld} width="418" loading="lazy" decoding="async" alt="" sizes="130px" />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section why-section band-paper">
    <div class="container why-layout">
      <div class="section-head"><h2>Waarom voor Auxilia kiezen?</h2></div>
      <div class="why-grid">
        {waarom.map(w => (
          <article class="waarom"><span class="waarom__icoon" aria-hidden="true"><Icon name={w.icon} size={24} /></span><h3>{w.t}</h3><p>{w.d}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section faq-section" id="faq">
    <div class="container faq-layout">
      <div class="section-head">
        <h2>Veelgestelde vragen</h2>
        <p class="lead">Staat je vraag er niet bij? De rest beantwoorden we voor jou bij een koffie.</p>
        <a href="/contact/" class="link-arrow faq__cta">Maak een afspraak <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <section class="slot-section">
    <div class="container">
      <div class="slot band-teal">
        <div class="slot__body">
          <h2 class="statement">Overtuigd? Plan een afspraak in.</h2>
          <p class="lead">Nog niet overtuigd? We hebben maar 30 minuten van je tijd nodig om je te overtuigen. Dit neem je sowieso mee naar huis:</p>
          <ul class="checklist slot__list">
            <li><Icon name="check" size={18} />Een beeld van waar AI bij jullie het snelst rendeert</li>
            <li><Icon name="check" size={18} />Wat je beter eerst zelf probeert, zonder ons</li>
            <li><Icon name="check" size={18} />Of het de moeite is om verder te praten</li>
          </ul>
          <a href={SITE.bookingUrl || '/contact/'} class="btn btn--primary btn--xl">Plan 30 minuten <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
        <SiteImage class="slot__mascot" src="/hero-contact-clean.png" alt="" width="1000" loading="lazy" sizes="(max-width: 700px) 70vw, 32vw" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 48px 0 80px; background: var(--hero-sage); }
  .hero__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .hero__tekst { padding: 12px 0 22px; }
  .hero-badge { margin: 0 0 28px; }
  .hero h1 { font-size: clamp(3.3rem, 6.5vw, 6rem); max-width: 10.5ch; line-height: 1.02; letter-spacing: -.055em; font-weight: 560; text-wrap: initial; }
  .hero__lead { margin: 30px 0 0; max-width: 47ch; color: var(--ink-soft); font-size: clamp(1rem, 1.3vw, 1.13rem); line-height: 1.7; }
  .hero__actions { margin-top: 32px; gap: 28px; }
  .btn--xl { padding: 18px 27px; min-height: 58px; }
  .hero__more { display: inline-flex; align-items: center; gap: 18px; font-size: .95rem; font-weight: 550; text-decoration: none; min-height: 44px; }
  .hero__visual { position: relative; align-self: stretch; min-height: 590px; border-radius: 160px 24px 24px 24px; overflow: hidden; background: #e7d9c7; }
  .hero__beeld { width: 100%; height: 100%; object-fit: cover; object-position: 44% 50%; position: absolute; inset: 0; }
  .hero__caption { position: absolute; left: 24px; right: 24px; bottom: 24px; display: flex; align-items: center; gap: 12px; background: #fff; padding: 16px 20px; border-radius: 12px; color: var(--ink); font-size: .9rem; font-weight: 500; }
  .hero__caption-icon { width: 34px; height: 34px; display: grid; place-items: center; flex: none; background: var(--brand-orange); border-radius: 50%; color: var(--orange-ink); }
  .hero__caption-mark { margin-left: auto; font-size: 1.4rem; }
  .strip { padding-block: 32px; border-block: 1px solid var(--line-soft); }
  .strip__row { display: flex; align-items: center; gap: 48px; }
  .strip__label { max-width: 22ch; margin: 0; flex: 0 0 220px; color: var(--ink-faint); font-size: .87rem; line-height: 1.5; }
  .strip__list { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 28px; list-style: none; padding: 0; margin: 0; flex: 1; }
  .strip__list li { display: flex; align-items: center; gap: 9px; color: var(--ink-soft); font-size: 1rem; font-weight: 550; white-space: nowrap; }
  .strip__logo { width: 20px; height: 20px; flex: none; }
  .products-section { background: var(--paper); }
  .products { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 24px; }
  .product { --product-surface: #f6ece6; display: flex; flex-direction: column; background: var(--product-surface); border-radius: 16px; overflow: hidden; border: 1px solid rgb(23 47 43 / 8%); }
  .product:nth-child(2) { --product-surface: #efddcd; }
  .product:nth-child(3) { --product-surface: #f0e0d2; }
  .product__top { display: flex; align-items: center; justify-content: space-between; padding: 30px 28px 0; }
  .product__naam { font-size: 2rem; font-weight: 570; letter-spacing: -.05em; }
  .product__symbol { display: grid; place-items: center; flex: none; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--brand-orange); background: var(--brand-orange); color: var(--orange-ink); font-size: 1.3rem; text-decoration: none; transition: background .2s var(--ease), border-color .2s var(--ease); }
  .product__symbol:hover { border-color: var(--brand-orange-hover); background: var(--brand-orange-hover); color: var(--orange-ink); }
  .product__symbol:focus-visible { outline: 3px solid var(--teal); outline-offset: 4px; }
  .product__visual { display: flex; align-items: center; justify-content: center; height: 280px; margin: 24px 28px 28px; }
  .product__visual :global(img) { width: 100%; height: 100%; min-height: 0; object-fit: contain; mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent), linear-gradient(to bottom, transparent, #000 4%, #000 96%, transparent); mask-composite: intersect; }
  .product__body { display: flex; flex-direction: column; flex: 1; padding: 0 28px 28px; }
  .product__vraag { font-size: 1.2rem; font-weight: 570; letter-spacing: -.025em; line-height: 1.35; margin-bottom: 14px; }
  .product__d { color: var(--ink-soft); font-size: .98rem; margin-bottom: 28px; flex: 1; }
  .product .link-arrow { border-top: 1px solid var(--line-soft); padding-top: 20px; font-size: .91rem; }
  .succesband { background: var(--teal-700); }
  .succesband .section-head { margin-bottom: 36px; }
  .succesband h2 { max-width: 18ch; }
  .succes { display: grid; grid-template-columns: 1fr 1.12fr; align-items: start; gap: 44px 64px; }
  .succes__klant { font-size: .85rem; color: #cfdbd2; margin-bottom: 20px; }
  .succes h3 { font-size: clamp(1.55rem, 2.3vw, 2.1rem); max-width: 24ch; font-weight: 500; letter-spacing: -.035em; margin-bottom: 22px; }
  .succes__body > p:not(.succes__klant) { color: #cadcd3; margin-bottom: 32px; }
  .succes__visual { align-self: start; background: #fff; padding: 8px; border-radius: 16px; }
  .succes__shot { width: 100%; height: auto; }
  .succes__cijfers { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1.12fr; gap: 72px; padding-top: 42px; border-top: 1px solid #ffffff30; }
  .succes__cijfers > div { display: flex; align-items: center; gap: 28px; }
  .succes__cijfers strong { color: #efd7b9; font-size: clamp(2.7rem, 4.7vw, 4.25rem); font-weight: 500; letter-spacing: -.055em; line-height: 1; white-space: nowrap; }
  .succes__cijfers span { max-width: 21ch; font-size: .92rem; color: #cadcd3; }
  .stappen__layout { display: grid; grid-template-columns: .8fr 1.2fr; gap: 80px; align-items: start; }
  .stappen__zij { position: sticky; top: 126px; }
  .stappen__kop { font-size: clamp(2rem, 3.2vw, 2.85rem); max-width: 17ch; }
  .stappen__visual { background: #f5eee4; border-radius: 18px 90px 18px 18px; overflow: hidden; width: 260px; }
  .stappen__beeld { width: 100%; mix-blend-mode: multiply; }
  .bigsteps { list-style: none; margin: 0; padding: 0; counter-reset: steps; }
  .bigstep { display: grid; grid-template-columns: 28px 1fr 112px; gap: 20px; align-items: start; padding: 32px 0; border-top: 1px solid var(--line); }
  .bigstep:last-child { border-bottom: 1px solid var(--line); }
  .bigstep__number { color: var(--teal-300); font-size: .86rem; font-weight: 600; padding-top: 5px; }
  .bigstep__body h3 { font-size: 1.35rem; line-height: 1.25; margin-bottom: 14px; }
  .bigstep__body p { color: var(--ink-soft); font-size: .97rem; }
  .bigstep__beeld { width: 112px; border-radius: 10px; }
  .why-layout { display: grid; grid-template-columns: .6fr 1.4fr; gap: 100px; }
  .why-layout h2 { max-width: 12ch; }
  .why-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 44px 48px; }
  .waarom__icoon { display: flex; align-items: center; margin-bottom: 18px; color: var(--teal); }
  .waarom h3 { font-size: 1.2rem; margin-bottom: 12px; }
