---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import StepScene from '../components/StepScene.astro';
import Faq from '../components/Faq.astro';
import { SERVICES, SITE } from '../config.js';

// De vragen die mensen ons echt stellen zodra ze horen wat we doen.
const faq = [
  {
    q: 'Wat kan zo’n AI nu concreet voor ons doen?',
    a: 'Het meeste kantoorwerk is lezen en schrijven: offertes opmaken, mails sorteren en beantwoorden, verslagen schrijven, gegevens van het ene systeem naar het andere brengen, vragen beantwoorden uit je eigen documenten. Daar is AI sterk in. Beslissingen nemen, klanten bellen en producten afleveren blijven werk voor mensen.',
  },
  {
    q: 'Wat kost dat?',
    a: 'We starten met een korte scan van je processen. Hiervoor wordt een standaard bedrag aangerekend; de grootte en de hoeveelheid van de processen maakt ons niet uit. Na de identificatie zitten we met jou samen en bekijken we welke processen nuttig zijn om verder uit te werken, en bespreken we de prijs.',
  },
  {
    q: 'Moet ons team technisch zijn?',
    a: 'Nee. Niemand hoeft te kunnen programmeren en je hebt geen IT-afdeling nodig. Wij doen het technische werk en leggen in gewone taal uit wat er gebeurt. Je team leert werken met het resultaat.',
  },
  {
    q: 'Wat gebeurt er met onze gegevens?',
    a: 'Je data blijft van jou. We spreken vooraf af welke bestanden gebruikt worden, waar ze staan en wie erbij kan. We werken volgens de GDPR en houden rekening met de Europese AI Act. Waar het kan, draait de verwerking op Europese servers.',
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE.url}/#faq`,
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const servicesSchema = SERVICES.map((s) => ({
  '@type': 'Service',
  '@id': `${SITE.url}/oplossingen/${s.slug}/#service`,
  name: s.title,
  description: s.excerpt,
  serviceType: s.short,
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: { '@type': 'Country', name: 'België' },
  url: `${SITE.url}/oplossingen/${s.slug}/`,
}));


const stappen = [
  {
    scene: 'werkvloer',
    beeld: '/stap-werkvloer.jpg',
    t: 'We beginnen bij jou op de werkvloer',
    d: 'We willen identificeren wat je bedrijf eigenlijk doet en wat de core business is. Welke tools je bedrijf gebruikt, en waar AI mogelijks een hulp kan zijn om je dagelijkse taken te versnellen.',
  },
  {
    scene: 'systemen',
    beeld: '/stap-tools.jpg',
    t: 'We bouwen toepassingen op de tools die je al hebt',
    d: 'Je boekhoudpakket, je mailbox, je CRM en je mappen blijven staan waar ze staan. We koppelen er AI aan vast en bouwen de handelingen na die je team vandaag manueel doet.',
  },
  {
    scene: 'team',
    beeld: '/stap-team.jpg',
    t: 'We geven het in handen van je team',
    d: 'Wij overhandigen de skills en workflows aan jou en je team, en leren jou hoe je ze het beste gebruikt. We tonen waar het waarde heeft om een taak op een vast schema te laten lopen, en waar AI het repetitieve werk doet terwijl iemand van jullie telkens nakijkt.',
  },
  {
    scene: 'buurt',
    beeld: '/stap-opvolgen.jpg',
    t: 'Wij volgen het proces op en helpen je verder bij onduidelijkheden',
    d: 'Bedrijven veranderen en tools ook. Wij houden het draaiend en bouwen uit wat werkt.',
  },
];

const producten = [
  {
    vraag: 'Weet je dat er iets moet doen met AI, maar niet wat?',
    naam: 'Scan',
    d: 'We lichten je processen door. Je krijgt een rapport/plan met de kansen, de berekeningen en een volgorde van aanpak.',
    href: '/oplossingen/kostenbesparing/',
    label: 'Hoe de scan werkt',
  },
  {
    vraag: 'Eén proces dat je wil aanpakken in je week?',
    naam: 'Bouw',
    d: 'Een app op maat die AI gebruikt waar dat loont. Werkend opgeleverd op de afgesproken datum, voor het afgesproken bedrag.',
    href: '/oplossingen/apps-op-maat/',
    label: 'Bekijk wat we bouwen',
  },
  {
    vraag: 'Nood aan een chatbot?',
    naam: 'Chat',
    d: 'Een assistent die antwoordt uit je eigen documenten, met bronvermelding.',
    href: '/oplossingen/ai-chatbots/',
    label: 'Zo werkt de chatbot',
  },
];

// Wat ons anders maakt dan een gewoon IT-bureau of een AI-abonnement.
const waarom = [
  {
    icon: 'users',
    t: 'Eén aanspreekpunt',
    d: 'AI én IT bij dezelfde mensen. Geen leveranciers die naar elkaar wijzen als er iets hapert.',
  },
  {
    icon: 'euro',
    t: 'Vaste prijs, vaste deadline',
    d: 'Je weet vooraf wat het kost en wanneer het klaar is. Geen uurtje-factuurtje achteraf.',
  },
  {
    icon: 'plug',
    t: 'Op je eigen systemen',
    d: 'Microsoft 365, Odoo, Billit, je eigen mappen. Je hoeft niets te vervangen of opnieuw te leren.',
  },
  {
    icon: 'check',
    t: 'We zeggen het als je ons niet nodig hebt',
    d: 'Volstaat een gewoon AI-abonnement voor wat je wil doen? Dan zeggen we dat, in plaats van je iets te verkopen.',
  },
  {
    icon: 'clock',
    t: 'Er wanneer jij ons nodig hebt',
    d: 'Gemaakt voor kleine KMO’s: je belt ons rechtstreeks, niet een ticketsysteem. Wij komen langs wanneer het jou past, niet wanneer het ons uitkomt.',
  },
];

---

<BaseLayout
  title="Auxilia · AI en IT voor KMO’s in de Kempen"
  exactTitle={true}
  description="AI-chatbots op je eigen data, apps op maat en automatisering voor KMO’s. Eén aanspreekpunt voor AI én IT. Vaste prijs, vaste deadline. Plan een kennismaking."
  schema={[faqSchema, ...servicesSchema]}
>
  <!-- ====================================================== hero (teal) -->
  <section class="hero band-teal">
    <div class="container hero__inner">
      <div class="hero__tekst">
        <h1>AI die voor je KMO werkt</h1>
        <p class="hero__lead">
          Offertes opmaken, verslagen schrijven, mails sorteren, gegevens van
          het ene systeem naar het andere sturen. Wij bouwen AI en apps op
          maat die dat voor jou overnemen, we gebruiken de software die je
          vandaag al gebruikt, met je eigen team aan het stuur.
        </p>
        <div class="btn-row hero__actions">
          <a href={SITE.bookingUrl || '/contact/'} class="btn btn--primary btn--xl">
            Plan 30 minuten
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <img
        class="hero__beeld"
        src="/hero-thuiswerk.jpg"
        width="1600"
        height="893"
        fetchpriority="high"
        decoding="async"
        alt="Illustratie: iemand ontspannen in een zetel bij het raam, terwijl documenten zichzelf opstapelen"
      />
    </div>
  </section>

  <!-- ==================================================== integraties -->
  <section class="section--tight band-sand strip">
    <div class="container strip__row">
      <p class="strip__label">We integreren de software die jij al gebruikt</p>
      <ul class="strip__list">
        <li>
          <svg class="strip__logo" viewBox="0 0 21 21" aria-hidden="true">
            <rect width="10" height="10" fill="#F25022"></rect>
            <rect x="11" width="10" height="10" fill="#7FBA00"></rect>
            <rect y="11" width="10" height="10" fill="#00A4EF"></rect>
            <rect x="11" y="11" width="10" height="10" fill="#FFB900"></rect>
          </svg>
          Microsoft 365
        </li>
        <li>
          <svg class="strip__logo" viewBox="0 0 48 48" aria-hidden="true">
            <path
              fill="#EA4335"
              d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
            ></path>
            <path
              fill="#4285F4"
              d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
            ></path>
            <path
              fill="#FBBC05"
              d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
            ></path>
            <path
              fill="#34A853"
              d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
            ></path>
          </svg>
          Google Workspace
        </li>
        <li>
          <!-- Vereenvoudigd merkteken; vervang bij lancering door het officiële logo. -->
          <svg class="strip__logo" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="10" cy="9" r="8" fill="#036C70"></circle>
            <circle cx="17.5" cy="13.5" r="6" fill="#1A9BA1"></circle>
            <circle cx="12" cy="19" r="4.5" fill="#37C6D0"></circle>
          </svg>
          SharePoint
        </li>
        <li>
          <svg class="strip__logo" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5" fill="none" stroke="#714B67" stroke-width="5"></circle>
          </svg>
          Odoo
        </li>
        <li>
          <!-- Officieel Billit-icoon (origami-vogel), verkleind ingebed. -->
          <img class="strip__logo" src="data:image/png;base64," alt="" width="18" height="18" />
          Billit
        </li>
      </ul>
    </div>
  </section>

  <!-- ========================================================== stappen -->
  <section class="section band-sand" id="werkwijze">
    <div class="container">
      <div class="stappen__layout">
        <aside class="stappen__zij reveal">
          <div class="section-head">
            <p class="eyebrow">Hoe we werken</p>
            <h2 class="stappen__kop">Auxilia zorgt ervoor dat AI ten dienste staat van u.</h2>
          </div>
          <img
            class="stappen__beeld"
            src="/aan-de-slag.jpg"
            width="522"
            height="700"
            loading="lazy"
            decoding="async"
            alt=""
          />
        </aside>

        <ol class="bigsteps">
          {
            stappen.map((s) => (
              <li class="bigstep reveal">
                <div class="bigstep__visual" aria-hidden="true">
                  {s.beeld ? (
                    <img
                      class="bigstep__beeld"
                      src={s.beeld}
                      width="418"
                      height="560"
                      loading="lazy"
                      decoding="async"
                      alt=""
                    />
                  ) : (
                    <StepScene name={s.scene} />
                  )}
                </div>
                <div class="bigstep__body">
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ==================================================== succesverhalen -->
  <section class="section succesband">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Succesverhalen</p>
        <h2>Waar hebben wij al geholpen?</h2>
      </div>

      <!-- Elk afgerond traject krijgt hier zo'n kaart. -->
      <article class="card succes reveal">
        <div class="succes__body">
          <p class="succes__klant">To B-Seen · eventveiligheid</p>
          <h3>Elk event een verslag zonder typen met behulp van AI</h3>
          <p>
            Foto’s en kernwoorden ter plaatse volstaan: AI schrijft het
            verslag, in de stijl van de expert zelf.
          </p>
          <div class="succes__cijfers">
            <div>
              <strong>3 uur</strong>
              <span>bespaard per rondgang</span>
            </div>
            <div>
              <strong>1 werkdag</strong>
              <span>per week terug gespendeerd aan klanten</span>
            </div>
          </div>
          <a href="/ons-werk/" class="link-arrow">
            Lees het hele verhaal
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <img
          class="succes__shot"
          src="/tobseen-app.png"
          width="1440"
          height="1080"
          loading="lazy"
          decoding="async"
          alt="De rapportage-app van To B-Seen op een telefoon: de observaties van een inspectieronde onder elkaar, met ernaast hoe AI een losse notitie uitschrijft tot een zin in het verslag."
        />
      </article>
    </div>
  </section>

  <!-- =========================================================== waarom -->
  <section class="section band-paper">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <h2>Waarom voor Auxilia kiezen?</h2>
      </div>

      <div class="grid grid--3 reveal">
        {
          waarom.map((w) => (
            <article class="card waarom">
              <span class="waarom__icoon" aria-hidden="true">
                <Icon name={w.icon} size={22} />
              </span>
              <h3 class="waarom__titel">{w.t}</h3>
              <p>{w.d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================== producten -->
  <section class="section band-paper">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <p class="eyebrow eyebrow--center">Kies je vertrekpunt</p>
        <h2>Drie van onze opties</h2>
      </div>

      <div class="grid grid--3 reveal">
        {
          producten.map((p) => (
            <article class="card product">
              <p class="product__vraag">{p.vraag}</p>
              <h3 class="product__naam">
                <span class="product__mark" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20">
                    <path
                      d="M5 14 L12 7.5 L19 14"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                {p.naam}
              </h3>
              {p.prijs && <p class="product__prijs">{p.prijs}</p>}
              <p class="product__d">{p.d}</p>
              <a href={p.href} class="link-arrow">
                {p.label}
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>

    </div>
  </section>

  <!-- ============================================================= faq -->
  <section class="section band-sand" id="faq">
    <div class="container">
      <div class="section-head reveal">
        <h2>Veelgestelde vragen</h2>
        <p class="lead">
          Staat je vraag er niet bij? De rest beantwoorden we jou bij een koffie.
        </p>
        <a href="/contact/" class="btn btn--primary faq__cta">
          Maak een afspraak
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="reveal">
        <Faq items={faq} />
      </div>
    </div>
  </section>

  <!-- ===================================================== slot (teal) -->
  <section class="section band-teal slot">
    <div class="container">
      <div class="slot__head reveal">
        <h2 class="statement">Overtuigd? Plan een afspraak in.</h2>
        <p class="lead">
          Nog niet overtuigd? We hebben maar 30 minuten van je tijd nodig om
          je te overtuigen. Dit neem je sowieso mee naar huis:
        </p>
      </div>

      <div class="slot__grid reveal">
        <ul class="checklist slot__list">
          <li>
            <Icon name="check" size={18} />
            Een beeld van waar AI bij jullie het snelst rendeert
          </li>
          <li>
            <Icon name="check" size={18} />
            Wat je beter eerst zelf probeert, zonder ons
          </li>
          <li>
            <Icon name="check" size={18} />
            Of het de moeite is om verder te praten
          </li>
        </ul>

        <div class="slot__cta">
          <a href={SITE.bookingUrl || '/contact/'} class="btn btn--primary btn--xl">
            Plan 30 minuten
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ------------------------------------------------------------- hero --- */

  .hero {
    position: relative;
    overflow: hidden;
    /* de donkere header loopt visueel door in het hero */
    margin-top: -78px;
    padding-top: calc(78px + clamp(3.5rem, 6vw, 6rem));
    padding-bottom: clamp(3.5rem, 6vw, 6rem);
    background: var(--teal);
  }

  /* Zelfde bandhoogte als de hero op alle andere pagina's. */
  @media (min-width: 900px) {
    .hero {
      display: flex;
      align-items: center;
      min-height: 730px;
    }

    .hero__inner {
      width: 100%;
    }
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    max-width: 1180px;
  }

  /* Tekst links, beeld rechts. Het beeld krijgt iets meer ruimte dan de
     tekst, want de figuur zit midden in het kader. */
  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr 1.05fr;
    }
  }

  .hero h1 {
    font-size: clamp(2.6rem, 5.4vw, 4.4rem);
    max-width: 14ch;
  }

  .hero__lead {
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    line-height: 1.55;
    color: rgba(250, 247, 242, 0.8);
    max-width: 44ch;
    margin: 24px 0 0;
  }

  .hero__actions {
    margin-top: 36px;
  }

  .btn--xl {
    padding: 18px 38px;
    font-size: 1.08rem;
  }

  .hero__beeld {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r-lg);
  }

  /* ------------------------------------------------------------ strip --- */

  .strip {
    border-bottom: 1px solid var(--line-soft);
    padding-block: 28px;
  }

  .strip__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 14px 40px;
  }

  .strip__label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0;
    max-width: none;
  }

  .strip__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 32px;
  }

  .strip__list li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 1.12rem;
    color: var(--ink-soft);
  }

  .strip__logo {
    width: 18px;
    height: 18px;
    flex: none;
  }

  /* Kop en beeld blijven links staan terwijl de stappen rechts passeren. */
  .stappen__layout {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
  }

  @media (min-width: 980px) {
    .stappen__layout {
      grid-template-columns: 0.82fr 1.18fr;
      align-items: start;
    }

    .stappen__zij {
      position: sticky;
      /* onder de plakkende header, met wat lucht */
      top: 108px;
    }
  }

  .stappen__zij {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vw, 32px);
  }

  .stappen__zij .section-head { margin-bottom: 0; }

  /* Een kolom die blijft staan mag niet hoger worden dan het scherm, anders
     schuift de kop er bovenaan uit. Vandaar kleiner dan een gewone sectiekop —
     en hij hoort de kaarten rechts ook niet te overstemmen. */
  .stappen__kop {
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
  }

  .stappen__beeld {
    display: block;
    width: 100%;
    max-width: 250px;
    height: auto;
    border-radius: var(--r);
  }

  /* ---------------------------------------------------------- bigsteps --- */

  .bigsteps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 24px;
  }

  .bigstep {
    display: grid;
    gap: 22px;
    background: var(--paper);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow);
    padding: clamp(26px, 3.2vw, 40px);
  }

  /* In een smallere kolom valt de strip-afwisseling weg: elke kaart krijgt
     dezelfde opbouw, tegel links en tekst rechts. */
  @media (min-width: 560px) {
    .bigstep {
      grid-template-columns: 158px 1fr;
      align-items: center;
      gap: clamp(24px, 3vw, 36px);
    }
  }

  .bigstep__visual {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 4;
    max-width: 158px;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(150deg, rgba(15, 92, 90, 0.1), rgba(15, 92, 90, 0.04));
  }

  .bigstep__beeld {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .bigstep__visual :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
    padding: 14px;
  }

  .bigstep__body h3 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    margin-bottom: 12px;
  }

  .bigstep__body p {
    color: var(--ink-soft);
    font-size: 1.05rem;
    margin: 0;
  }

  /* --------------------------------------------------- succesverhalen --- */

  /* De warme popband: klei-zacht, het verhaal voorop. */
  .succesband {
    background: var(--clay-soft);
  }

  .succes {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
    align-items: center;
    padding: clamp(30px, 4vw, 52px);
  }

  @media (min-width: 880px) {
    .succes {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* De mockup heeft zelf al een witte rand, dus geen kader eromheen. */
  .succes__shot {
    display: block;
    width: 100%;
    height: auto;
  }

  .succes__klant {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--clay-700);
    margin-bottom: 14px;
  }

  .succes h3 {
