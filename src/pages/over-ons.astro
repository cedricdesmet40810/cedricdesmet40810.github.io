---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';

/**
 * Portretten zijn bewust nog initialen. Zodra er documentaire foto's zijn
 * (natuurlijk licht, aan het werk, niet poserend), vervang je `initialen`
 * door een <Image>. De rest van de kaart blijft gelijk.
 */
const team = [
  {
    initialen: 'CD',
    naam: 'Cedric De Smet',
    rol: 'Bouw & implementatie',
    d: 'Cedric bouwt en implementeert de toepassingen. Hij bespreekt de technische keuzes met je en legt uit hoe de oplossing werkt.',
  },
  {
    initialen: 'KV',
    naam: 'Kevin Vaal',
    rol: 'Proces & opleiding',
    d: 'Kevin brengt je processen in kaart en bespreekt met je team wat er verandert. Hij begeleidt jullie bij het gebruik van de nieuwe toepassingen.',
  },
];

const overtuigingen = [
  {
    n: '01',
    titel: 'Rechtstreeks contact',
    tekst: 'Wij blijven bewust klein. Je praat rechtstreeks met de mensen die je oplossing bouwen.',
  },
  {
    n: '02',
    titel: 'Opleveren is niet hetzelfde als helpen',
    tekst: 'Software die niemand gebruikt, heeft nul waarde. Pas als je team er zelfstandig mee verder kan, is het project echt klaar.',
  },
  {
    n: '03',
    titel: 'AI is geen toverspreuk',
    tekst: 'We gebruiken AI waar het iets oplevert. Soms volstaat een betere instelling in bestaande software of een duidelijkere werkafspraak.',
  },
];
---

<BaseLayout
  title="Over ons"
  metaTitle="Over Auxilia: AI en IT uit de Kempen"
  description="Maak kennis met Cedric en Kevin van Auxilia. AI en IT voor kmo’s vanuit de Kempen, met rechtstreeks contact en begeleiding voor je team."
  breadcrumbs={[{ name: 'Over ons', href: '/over-ons/' }]}
>
  <PageHero
    crumbs={[{ name: 'Over ons', href: '/over-ons/' }]}
    title="Wie er achter Auxilia zit"
    lead="Cedric bouwt de toepassingen. Kevin brengt je processen in kaart en begeleidt je team. Samen zijn we Auxilia, gestart in 2026."
  />

  <!-- Naam origin -->
  <section class="band-sand naam-band">
    <div class="container">
      <div class="panel intro-card">
        <div>
          <p class="eyebrow">De naam</p>
          <p class="intro-statement">Auxilia waren de hulptroepen die het Romeinse leger kwamen versterken. Ze namen het niet over: ze maakten het sterker.</p>
        </div>
        <div class="intro-tekst">
          <p>Die naam past bij onze aanpak: we ondersteunen je team, automatiseren terugkerend werk en leren jullie met de oplossing werken.</p>
          <p>We zorgen dat je team zelfstandig met de oplossing kan werken. Voor onderhoud, vragen en verdere uitbouw blijven we bereikbaar.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Jong bedrijf -->
  <section class="section band-paper">
    <div class="container split split--top">
      <div class="reveal">
        <p class="eyebrow">Samenwerken met Auxilia</p>
        <h2>Rechtstreeks contact met Cedric en Kevin</h2>
        <p>
          Je bespreekt je vraag met de mensen die aan je oplossing werken. Cedric bouwt de toepassingen. Kevin brengt je processen in kaart en begeleidt je team bij het gebruik.
        </p>
      </div>
      <div class="reveal">
        <div class="panel">
          <h3 class="panel__title">Wat dat concreet betekent</h3>
          <ul class="checklist">
            <li>
              <Icon name="check" size={18} />
              Je praat rechtstreeks met wie het bouwt
            </li>
            <li>
              <Icon name="check" size={18} />
              AI-tools afgestemd op je processen en bestaande software
            </li>
            <li>
              <Icon name="check" size={18} />
              Persoonlijk contact met mensen die je bedrijf kennen
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Mini-manifest -->
  <section class="section band-sand">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Wat wij geloven</p>
        <h2>Drie uitgangspunten voor onze samenwerking</h2>
      </div>
      <ol class="numbered reveal">
        {
          overtuigingen.map((o) => (
            <li>
              <span class="numbered__n">{o.n}</span>
              <div>
                <h3>{o.titel}</h3>
                <p>{o.tekst}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Team -->
  <section class="section band-paper">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Ons team</p>
        <h2>De mensen achter je oplossing</h2>
        <p class="lead">
          Van het eerste gesprek tot lang na de oplevering praat je met dezelfde twee mensen.
        </p>
      </div>

      <div class="grid grid--2 reveal">
        {
          team.map((p) => (
            <article class="card person">
              <span class="person__avatar" aria-hidden="true">
                {p.initialen}
              </span>
              <div>
                <h3>{p.naam}</h3>
                <p class="person__rol">{p.rol}</p>
                <p>{p.d}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Kennismaken"
    title="Bespreek je vraag met ons"
    text="Vertel hoe je werkt en waar je tegenaan loopt. We denken mee over een volgende stap, online of bij jou op kantoor."
    secondary={{ label: 'Bekijk de oplossingen', href: '/oplossingen/' }}
  />
</BaseLayout>

<style>
  .naam-band {
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
  }

  .intro-card {
    margin-top: -24px;
    position: relative;
    z-index: 2;
    box-shadow: none;
    display: grid;
    gap: 28px 48px;
    align-items: center;
  }

  @media (min-width: 820px) {
    .intro-card {
      grid-template-columns: 1fr 1fr;
    }
  }

  .intro-statement {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.9rem);
    font-weight: 550;
    letter-spacing: -0.018em;
    line-height: 1.22;
    color: var(--ink);
    margin: 0;
    max-width: none;
  }

  .split h2 { margin-bottom: 24px; }

  .intro-tekst p {
    color: var(--ink-soft);
  }

  .panel__title {
    margin-bottom: 20px;
  }

  /* ----------------------------------------------------------- team --- */

  .person {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 22px;
    align-items: start;
  }

  .person__avatar {
    width: 72px;
    height: 72px;
    display: grid;
    place-items: center;
    border-radius: 20px;
    background: var(--teal);
    color: var(--sand);
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .person h3 {
    margin-bottom: 4px;
  }

  .person__rol {
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--teal);
    margin-bottom: 12px;
  }

  @media (max-width: 480px) {
    .person {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
