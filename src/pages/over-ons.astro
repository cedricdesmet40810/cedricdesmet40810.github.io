---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';

/**
 * Portretten zijn bewust nog initialen. Zodra er documentaire foto's zijn
 * (natuurlijk licht, aan het werk, niet poserend), vervang je `initialen`
 * door een <Image>. De rest van de kaart blijft gelijk.
 */
const team = [
  {
    initialen: 'CD',
    naam: 'Cedric De Smet',
    rol: 'Bouw & implementatie',
    d: 'Cedric bouwt wat afgesproken is, en dan nog iets extra zodat het ook over zes maanden nog werkt. Vraag hem hoe iets technisch in elkaar zit en hij legt het uit totdat jij het snapt, niet totdat híj denkt dat je het snapt.',
  },
  {
    initialen: 'KV',
    naam: 'Kevin Vaal',
    rol: 'Proces & opleiding',
    d: 'Kevin stelt de vraag die niemand stelt: "Maar waarom doen jullie dit eigenlijk zo?" Niet om lastig te zijn, maar omdat het antwoord bijna altijd bepaalt wat er gebouwd moet worden. Hij gaat pas weg als je team het zonder hem kan.',
  },
];

const overtuigingen = [
  {
    n: '01',
    titel: 'Groot bureau, kleine aandacht',
    tekst: 'Hoe groter het bureau, hoe groter de afstand tussen jou en wie het werk doet. Wij blijven klein met opzet.',
  },
  {
    n: '02',
    titel: 'Opleveren is niet hetzelfde als helpen',
    tekst: 'Software die niemand gebruikt, heeft nul waarde. Pas als je team er zelfstandig mee verder kan, is het project echt klaar.',
  },
  {
    n: '03',
    titel: 'AI is geen toverspreuk',
    tekst: 'We gebruiken het dagelijks, maar verkopen het niet als oplossing voor alles. Een goed proces heeft AI nodig als hulp, niet als alibi.',
  },
];
---

<BaseLayout
  title="Over ons"
  metaTitle="Over Auxilia: AI en IT uit de Kempen"
  description="Auxilia is een jong AI- en IT-bedrijf uit de Kempen: Cedric en Kevin, allebei geschoold in software, met To B-Seen als eerste bewijs dat het werkt."
  breadcrumbs={[{ name: 'Over ons', href: '/over-ons/' }]}
>
  <PageHero
    crumbs={[{ name: 'Over ons', href: '/over-ons/' }]}
    title="Wie er achter Auxilia zit"
    lead="Cedric bouwt. Kevin vertaalt. Samen zijn we Auxilia, gestart in 2026, met één duidelijk idee over hoe IT voor kmo's anders kan."
  />

  <!-- Naam origin -->
  <section class="band-sand naam-band">
    <div class="container">
      <div class="panel intro-card">
        <div>
          <p class="eyebrow">De naam</p>
          <p class="intro-statement">Auxilia waren de hulptroepen die het Romeinse leger kwamen versterken. Ze namen het niet over: ze maakten het sterker.</p>
        </div>
        <div class="intro-tekst">
          <p>Dat leek ons een juiste naam voor wat we doen: naast je team gaan staan, het saaie werk automatiseren en pas vertrekken als het zonder ons verder kan.</p>
          <p>Geen externe dienstverlener die je afhankelijk houdt. Een partij die zichzelf overbodig maakt.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Jong bedrijf -->
  <section class="section band-paper">
    <div class="container split split--top">
      <div class="reveal">
        <p class="eyebrow">Waarom dat geen nadeel is</p>
        <h2>Jong bedrijf, en dat merk je aan de goede kant</h2>
        <p>
          Wie ons belt, krijgt geen accountmanager en geen junior die het dossier erbij neemt. Je krijgt de twee mensen die het ook echt bouwen, met de aandacht die een eerste generatie klanten nu eenmaal krijgt: veel.
        </p>
      </div>
      <div class="reveal">
        <div class="panel">
          <h3 class="panel__title">Wat dat concreet betekent</h3>
          <ul class="checklist">
            <li>
              <Icon name="check" size={18} />
              Je praat rechtstreeks met wie het bouwt
            </li>
            <li>
              <Icon name="check" size={18} />
              Gebouwd met de huidige generatie AI-tools, niet met wat we toevallig in de kast hadden
            </li>
            <li>
              <Icon name="check" size={18} />
              Je nummer staat in onze telefoon, niet in een ticketsysteem
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Mini-manifest -->
  <section class="section band-sand">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Wat wij geloven</p>
        <h2>Drie dingen die de meeste IT-trajecten doen mislukken</h2>
      </div>
      <ol class="numbered reveal">
        {
          overtuigingen.map((o) => (
            <li>
              <span class="numbered__n">{o.n}</span>
              <div>
                <h3>{o.titel}</h3>
                <p>{o.tekst}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Team -->
  <section class="section band-paper">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Wie je krijgt</p>
        <h2>Er zit niemand tussen jou en wie het bouwt</h2>
        <p class="lead">
          Van het eerste gesprek tot lang na de oplevering praat je met dezelfde twee mensen.
        </p>
      </div>

      <div class="grid grid--2 reveal">
        {
          team.map((p) => (
            <article class="card person">
              <span class="person__avatar" aria-hidden="true">
                {p.initialen}
              </span>
              <div>
                <h3>{p.naam}</h3>
                <p class="person__rol">{p.rol}</p>
                <p>{p.d}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Kennismaken"
    title="Kom eens langs met je vraag"
    text="Of wij komen naar jou, dat rijdt snel genoeg in de Kempen. Vertel wat je doet en waar het kraakt, dan zeggen we eerlijk wat wij zouden aanpakken."
    secondary={{ label: 'Bekijk de oplossingen', href: '/oplossingen/' }}
  />
</BaseLayout>

<style>
  .naam-band {
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
  }

  .intro-card {
    margin-top: -24px;
    position: relative;
    z-index: 2;
    box-shadow: none;
    display: grid;
    gap: 28px 48px;
    align-items: center;
  }

  @media (min-width: 820px) {
    .intro-card {
      grid-template-columns: 1fr 1fr;
    }
  }

  .intro-statement {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.9rem);
    font-weight: 550;
    letter-spacing: -0.018em;
    line-height: 1.22;
    color: var(--ink);
    margin: 0;
    max-width: none;
  }

  .split h2 { margin-bottom: 24px; }

  .intro-tekst p {
    color: var(--ink-soft);
  }

  .panel__title {
    margin-bottom: 20px;
  }

  /* ----------------------------------------------------------- team --- */

  .person {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 22px;
    align-items: start;
  }

  .person__avatar {
    width: 72px;
    height: 72px;
    display: grid;
    place-items: center;
    border-radius: 20px;
    background: var(--teal);
    color: var(--sand);
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .person h3 {
    margin-bottom: 4px;
  }

  .person__rol {
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--teal);
    margin-bottom: 12px;
  }

  @media (max-width: 480px) {
    .person {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
